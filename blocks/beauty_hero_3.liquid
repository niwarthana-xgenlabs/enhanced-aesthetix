            {{ block.settings.button_label }}
          </a>
        {% endif %}
      </div>

        <!-- Tab 2 Content -->
        <div class="beauty-hero__tab-content-{{ hero_id }}" data-content="tab2">
        {% if block.settings.tab2_category != blank %}
