{% assign hero_id = block.id | replace: '_', '' | downcase %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;700&display=swap');

  .beauty-hero-{{ hero_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: 60px 20px;
    font-family: 'Poppins', sans-serif;
  }

  .beauty-hero__container-{{ hero_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .beauty-hero-{{ hero_id }} {
      padding: 80px 40px;
    }

    .beauty-hero__container-{{ hero_id }} {
      grid-template-columns: 1fr 1fr;
      gap: 60px;
    }
  }

  .beauty-hero__content-{{ hero_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: relative;
  }

  .beauty-hero__content-wrapper-{{ hero_id }} {
    position: relative;
    min-height: 300px;
  }

  @media screen and (min-width: 990px) {
    .beauty-hero__content-wrapper-{{ hero_id }} {
      min-height: 400px;
    }
  }

  .beauty-hero__tabs-{{ hero_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
  }

  .beauty-hero__tab-{{ hero_id }} {
    padding: 8px 16px;
    background-color: transparent;
    color: {{ block.settings.primary_color }};
    border: 1px solid {{ block.settings.primary_color }};
    border-radius: 20px;
    font-size: 11px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    font-weight: 500;
    font-family: 'Poppins', sans-serif;
  }

  .beauty-hero__tab-{{ hero_id }}:hover,
  .beauty-hero__tab-{{ hero_id }}.active {
    background-color: {{ block.settings.primary_color }};
    color: {{ block.settings.background_color }};
  }

  .beauty-hero__category-{{ hero_id }} {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ block.settings.primary_color }};
    font-weight: 500;
    margin: 0;
    font-family: 'Poppins', sans-serif;
  }

  [data-content="tab1"] .beauty-hero__category-{{ hero_id }},
  [data-content="tab2"] .beauty-hero__category-{{ hero_id }},
  [data-content="tab3"] .beauty-hero__category-{{ hero_id }},
  [data-content="tab4"] .beauty-hero__category-{{ hero_id }},
  [data-content="tab5"] .beauty-hero__category-{{ hero_id }} {
    color: #000000;
  }

  .beauty-hero__heading-{{ hero_id }} {
    font-size: 36px;
    line-height: 1.2;
    color: {{ block.settings.primary_color }};
    margin: 0;
    font-weight: 700;
    font-family: 'Poppins', sans-serif;
  }

  [data-content="tab1"] .beauty-hero__heading-{{ hero_id }},
  [data-content="tab2"] .beauty-hero__heading-{{ hero_id }},
  [data-content="tab3"] .beauty-hero__heading-{{ hero_id }},
  [data-content="tab4"] .beauty-hero__heading-{{ hero_id }},
  [data-content="tab5"] .beauty-hero__heading-{{ hero_id }} {
    font-weight: 400;
  }

  @media screen and (min-width: 990px) {
    .beauty-hero__heading-{{ hero_id }} {
      font-size: {{ block.settings.heading_size }}px;
    }
  }

  .beauty-hero__description-{{ hero_id }} {
    font-size: 16px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin: 0;
    font-family: 'Poppins', sans-serif;
  }

  @media screen and (min-width: 990px) {
    .beauty-hero__description-{{ hero_id }} {
      font-size: 18px;
    }
  }

  [data-content="tab1"] .beauty-hero__description-{{ hero_id }},
  [data-content="tab2"] .beauty-hero__description-{{ hero_id }},
  [data-content="tab3"] .beauty-hero__description-{{ hero_id }},
  [data-content="tab4"] .beauty-hero__description-{{ hero_id }},
  [data-content="tab5"] .beauty-hero__description-{{ hero_id }} {
    font-size: 14px;
  }

  @media screen and (min-width: 990px) {
    [data-content="tab1"] .beauty-hero__description-{{ hero_id }},
    [data-content="tab2"] .beauty-hero__description-{{ hero_id }},
    [data-content="tab3"] .beauty-hero__description-{{ hero_id }},
    [data-content="tab4"] .beauty-hero__description-{{ hero_id }},
    [data-content="tab5"] .beauty-hero__description-{{ hero_id }} {
      font-size: 16px;
    }
  }

  .beauty-hero__button-{{ hero_id }} {
    display: inline-block;
    padding: 0;
    background-color: transparent;
    color: {{ block.settings.primary_color }};
    border: none;
    text-decoration: none;
    font-size: 14px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    transition: all 0.3s ease;
    font-weight: 500;
    align-self: flex-start;
    border-bottom: 2px solid {{ block.settings.primary_color }};
    padding-bottom: 4px;
    font-family: 'Poppins', sans-serif;
  }

  .beauty-hero__button-{{ hero_id }}:hover {
    opacity: 0.7;
  }

  .beauty-hero__image-wrapper-{{ hero_id }} {
    position: relative;
    width: 50%;
    max-width: 300px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 200px 200px 200px 0;
    min-height: 400px;
  }

  @media screen and (min-width: 990px) {
    .beauty-hero__image-wrapper-{{ hero_id }} {
      width: 45%;
      max-width: 350px;
    }
  }

  .beauty-hero__image-{{ hero_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 3 / 4;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    opacity: 1;
    visibility: visible;
  }

  .beauty-hero__image-{{ hero_id }}.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .beauty-hero__image-placeholder-{{ hero_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    background-color: #f5f0e8;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .beauty-hero__image-placeholder-{{ hero_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
  }

  .beauty-hero__empty-state-{{ hero_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 24px;
    background-color: rgba(255, 255, 255, 0.9);
    color: {{ block.settings.primary_color }};
    font-size: 14px;
    border-radius: 4px;
    pointer-events: none;
    font-family: 'Poppins', sans-serif;
  }

  .beauty-hero__tab-content-{{ hero_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .beauty-hero__tab-content-{{ hero_id }}.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  @media screen and (max-width: 989px) {
    .beauty-hero__container-{{ hero_id }} {
      grid-template-columns: 1fr;
    }

    .beauty-hero__image-wrapper-{{ hero_id }} {
      order: 2;
    }

    .beauty-hero__content-{{ hero_id }} {
      order: 1;
    }
  }
{% endstyle %}

<beauty-hero-{{ hero_id }} class="beauty-hero-{{ hero_id }}" {{ block.shopify_attributes }}>
