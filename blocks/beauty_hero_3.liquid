</beauty-hero-{{ hero_id }}>

<script>
  (function() {
    class BeautyHero{{ hero_id }} extends HTMLElement {
      constructor() {
        super();
        this.tabs = this.querySelectorAll('.beauty-hero__tab-{{ hero_id }}');
        this.contents = this.querySelectorAll('.beauty-hero__tab-content-{{ hero_id }}');
        this.images = this.querySelectorAll('.beauty-hero__image-{{ hero_id }}');
        this.contentWrapper = this.querySelector('.beauty-hero__content-wrapper-{{ hero_id }}');
      }

      connectedCallback() {
        this.tabs.forEach(tab => {
          tab.addEventListener('click', (e) => this.handleTabClick(e));
        });
        
        // Set fixed height based on tallest content to prevent layout shift
        this.setContentHeight();
      }

      setContentHeight() {
        if (!this.contentWrapper) return;
        
        let maxHeight = 0;
        const originalStyles = [];
        
        // Temporarily show all content to measure
        this.contents.forEach((content, index) => {
          originalStyles[index] = {
            position: content.style.position,
            opacity: content.style.opacity,
            visibility: content.style.visibility,
            display: content.style.display
          };
          
          content.style.position = 'static';
          content.style.opacity = '1';
          content.style.visibility = 'visible';
          content.style.display = 'flex';
          
          const height = content.offsetHeight;
          if (height > maxHeight) {
            maxHeight = height;
          }
        });
        
        // Reset to original state
        this.contents.forEach((content, index) => {
          if (originalStyles[index]) {
            content.style.position = originalStyles[index].position;
            content.style.opacity = originalStyles[index].opacity;
            content.style.visibility = originalStyles[index].visibility;
            content.style.display = originalStyles[index].display;
          }
        });
        
        // Set the wrapper height with some padding
        if (maxHeight > 0) {
          this.contentWrapper.style.height = (maxHeight + 20) + 'px';
        }
      }

      handleTabClick(e) {
        e.preventDefault();
        const clickedTab = e.target;
        const tabName = clickedTab.getAttribute('data-tab');

        // Remove active class from all tabs
        this.tabs.forEach(tab => tab.classList.remove('active'));
        
        // Add active class to clicked tab
        clickedTab.classList.add('active');

        // Hide all content
        this.contents.forEach(content => content.classList.remove('active'));

        // Show selected content
        const activeContent = this.querySelector(`[data-content="${tabName}"]`);
        if (activeContent) {
          activeContent.classList.add('active');
        }

        // Hide all images
        this.images.forEach(img => img.classList.add('hidden'));

        // Show selected image
        const activeImage = this.querySelector(`[data-tab-image="${tabName}"]`);
        if (activeImage) {
          activeImage.classList.remove('hidden');
        } else {
          // Fallback to tab1 image if no specific image for this tab
          const fallbackImage = this.querySelector(`[data-tab-image="tab1"]`);
          if (fallbackImage) {
            fallbackImage.classList.remove('hidden');
          }
        }
      }
    }

    customElements.define('beauty-hero-{{ hero_id }}', BeautyHero{{ hero_id }});
  })();
</script>

