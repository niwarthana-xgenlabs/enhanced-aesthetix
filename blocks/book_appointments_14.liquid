{% assign block_id = block.id | replace: '_', '' | downcase %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

{% style %}
  .appointment-section-{{ block_id }} {
    background-color: {{ block.settings.section_background_color }};
    padding: 60px 20px;
    width: 100%;
    display: block;
    font-family: 'Poppins', sans-serif;
    scroll-margin-top: 100px;
  }

  .appointment-container-{{ block_id }} {
    max-width: 1200px;
    margin: 0 auto;
    background-color: #ffffff;
    border-radius: {{ block.settings.container_border_radius }}px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    padding: 60px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }

  .appointment-left-{{ block_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .appointment-label-{{ block_id }} {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ block.settings.label_color }};
    margin: 0;
    font-family: 'Poppins', sans-serif;
  }

  .appointment-heading-{{ block_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
    font-family: 'Poppins', sans-serif;
  }

  .appointment-description-{{ block_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    color: {{ block.settings.description_color }};
    margin: 0;
    font-family: 'Poppins', sans-serif;
  }

  .appointment-contact-list-{{ block_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 20px;
  }

  .appointment-contact-item-{{ block_id }} {
    display: flex;
    align-items: flex-start;
    gap: 15px;
  }

  .appointment-icon-{{ block_id }} {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    color: {{ block.settings.icon_color }};
  }

  .appointment-contact-text-{{ block_id }} {
    font-size: {{ block.settings.contact_text_size }}px;
    line-height: 1.5;
    color: {{ block.settings.contact_text_color }};
    font-family: 'Poppins', sans-serif;
  }

  .appointment-right-{{ block_id }} {
    display: flex;
    flex-direction: column;
  }

  .appointment-form-card-{{ block_id }} {
    background-color: {{ block.settings.form_card_background }};
    border-radius: {{ block.settings.form_card_border_radius }}px;
    padding: 40px;
  }

  .appointment-form-title-{{ block_id }} {
    font-size: {{ block.settings.form_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.form_title_color }};
    margin: 0 0 30px 0;
    font-family: 'Poppins', sans-serif;
  }

  .appointment-form-{{ block_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .appointment-form-row-{{ block_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
  }

  .appointment-form-group-{{ block_id }} {
    display: flex;
    flex-direction: column;
  }

  .appointment-input-{{ block_id }},
  .appointment-textarea-{{ block_id }} {
    background-color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: {{ block.settings.input_border_radius }}px;
    padding: 15px 20px;
    font-size: 15px;
    color: #333333;
    transition: border-color 0.3s ease;
    font-family: 'Poppins', sans-serif;
  }

  .appointment-input-{{ block_id }}::placeholder,
  .appointment-textarea-{{ block_id }}::placeholder {
    color: #999999;
  }

  .appointment-input-{{ block_id }}:focus,
  .appointment-textarea-{{ block_id }}:focus {
    outline: none;
    border-color: rgba(0, 0, 0, 0.2);
  }

  .appointment-textarea-{{ block_id }} {
    min-height: 120px;
    resize: vertical;
    font-family: inherit;
  }

  .appointment-submit-{{ block_id }} {
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    padding: 16px 32px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    font-family: 'Poppins', sans-serif;
  }

  .appointment-submit-{{ block_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    transform: translateY(-2px);
  }

  .appointment-arrow-{{ block_id }} {
    font-size: 18px;
  }

  .appointment-success-{{ block_id }} {
    color: #008060;
    margin-top: 15px;
    font-size: 14px;
    font-family: 'Poppins', sans-serif;
  }

  .appointment-error-{{ block_id }} {
    color: #D82C0D;
    margin-top: 8px;
    font-size: 14px;
    font-family: 'Poppins', sans-serif;
  }

  @media screen and (max-width: 768px) {
    .appointment-section-{{ block_id }} {
      padding: 40px 15px;
    }

    .appointment-container-{{ block_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 40px 30px;
    }

    .appointment-heading-{{ block_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .appointment-form-row-{{ block_id }} {
      grid-template-columns: 1fr;
    }

    .appointment-form-card-{{ block_id }} {
      padding: 30px 25px;
    }
  }
{% endstyle %}

<appointment-contact-{{ block_id }} id="book-appointment-section" class="appointment-section-{{ block_id }}" {{ block.shopify_attributes }}>
  <div class="appointment-container-{{ block_id }}">
    <div class="appointment-left-{{ block_id }}">
      {% if block.settings.label_text != blank %}
        <p class="appointment-label-{{ block_id }}">{{ block.settings.label_text }}</p>
      {% endif %}

      {% if block.settings.heading_text != blank %}
        <h2 class="appointment-heading-{{ block_id }}">{{ block.settings.heading_text }}</h2>
      {% endif %}

      {% if block.settings.description_text != blank %}
        <div class="appointment-description-{{ block_id }}">
          {{ block.settings.description_text }}
        </div>
      {% endif %}

      <div class="appointment-contact-list-{{ block_id }}">
        {% if block.settings.phone_number != blank %}
          <div class="appointment-contact-item-{{ block_id }}">
            <svg class="appointment-icon-{{ block_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <div class="appointment-contact-text-{{ block_id }}">{{ block.settings.phone_number }}</div>
          </div>
        {% endif %}

        {% if block.settings.address_text != blank %}
          <div class="appointment-contact-item-{{ block_id }}">
            <svg class="appointment-icon-{{ block_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div class="appointment-contact-text-{{ block_id }}">{{ block.settings.address_text }}</div>
          </div>
        {% endif %}

        {% if block.settings.email_address != blank %}
          <div class="appointment-contact-item-{{ block_id }}">
            <svg class="appointment-icon-{{ block_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <div class="appointment-contact-text-{{ block_id }}">{{ block.settings.email_address }}</div>
          </div>
        {% endif %}

        {% if block.settings.business_hours != blank %}
          <div class="appointment-contact-item-{{ block_id }}">
            <svg class="appointment-icon-{{ block_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div class="appointment-contact-text-{{ block_id }}">{{ block.settings.business_hours }}</div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="appointment-right-{{ block_id }}">
      <div class="appointment-form-card-{{ block_id }}">
        {% if block.settings.form_title != blank %}
          <h3 class="appointment-form-title-{{ block_id }}">{{ block.settings.form_title }}</h3>
        {% endif %}

        {%- form 'contact' -%}
          <input type="hidden" name="contact[subject]" value="Appointment Request">
          
          <div class="appointment-form-{{ block_id }}">
            <div class="appointment-form-row-{{ block_id }}">
              <div class="appointment-form-group-{{ block_id }}">
                <input
                  type="text"
                  name="contact[name]"
                  class="appointment-input-{{ block_id }}"
                  placeholder="{{ block.settings.name_placeholder }}"
                  value="{{ form.name }}"
                  required
                >
              </div>
              <div class="appointment-form-group-{{ block_id }}">
                <input
                  type="tel"
                  name="contact[phone]"
                  class="appointment-input-{{ block_id }}"
                  placeholder="{{ block.settings.phone_placeholder }}"
                  value="{{ form.phone }}"
                  required
                >
              </div>
            </div>

            <div class="appointment-form-group-{{ block_id }}">
              <input
                type="email"
                name="contact[email]"
                class="appointment-input-{{ block_id }}"
                placeholder="{{ block.settings.email_placeholder }}"
                value="{{ form.email }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="appointment-error-{{ block_id }}"
                {% endif %}
                {% if form.posted_successfully? %}
                  aria-describedby="appointment-success-{{ block_id }}"
                {% endif %}
                required
              >
            </div>

            <div class="appointment-form-group-{{ block_id }}">
              <textarea
                name="contact[body]"
                class="appointment-textarea-{{ block_id }}"
                placeholder="{{ block.settings.message_placeholder }}"
                required
              >{{ form.body }}</textarea>
            </div>

            <button type="submit" class="appointment-submit-{{ block_id }}">
              {{ block.settings.button_text }}
              <span class="appointment-arrow-{{ block_id }}">→</span>
            </button>

            {%- if form.errors -%}
              <div id="appointment-error-{{ block_id }}" class="appointment-error-{{ block_id }}">
                <span>{{ form.errors.messages.email }}</span>
              </div>
            {%- endif -%}

            {%- if form.posted_successfully? -%}
              <div id="appointment-success-{{ block_id }}" class="appointment-success-{{ block_id }}">
                <span>{{ block.settings.success_message }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</appointment-contact-{{ block_id }}>

<script>
  (function() {
    class AppointmentContact{{ block_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('form');
        if (this.form) {
          this.form.addEventListener('submit', this.handleSubmit.bind(this));
        }
      }

      handleSubmit(event) {
        const inputs = this.form.querySelectorAll('input[required], textarea[required]');
        let isValid = true;

        inputs.forEach(input => {
          if (!input.value.trim()) {
            isValid = false;
            input.style.borderColor = '#D82C0D';
          } else {
            input.style.borderColor = 'rgba(255, 255, 255, 0.3)';
          }
        });

        if (!isValid) {
          event.preventDefault();
        }
      }
    }

    customElements.define('appointment-contact-{{ block_id }}', AppointmentContact{{ block_id }});
  })();
</script>

