{% assign block_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .footer-{{ block_id }} {
    background-color: {{ block.settings.footer_background }};
    width: 100%;
    padding: 30px 0 0;
  }

  .footer-container-{{ block_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .footer-columns-{{ block_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    margin-bottom: 25px;
  }

  .footer-column-{{ block_id }} {
    display: flex;
    flex-direction: column;
  }

  .footer-logo-{{ block_id }} {
    margin-bottom: 15px;
    max-width: {{ block.settings.logo_width }}px;
  }

  .footer-logo-{{ block_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .footer-brand-description-{{ block_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.body_text_size }}px;
    line-height: 1.5;
    margin-bottom: 15px;
  }

  .footer-social-icons-{{ block_id }} {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .footer-social-link-{{ block_id }} {
    width: {{ block.settings.social_icon_size }}px;
    height: {{ block.settings.social_icon_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.social_icon_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease, transform 0.2s ease;
    text-decoration: none;
  }

  .footer-social-link-{{ block_id }}:hover {
    background-color: {{ block.settings.social_icon_hover_bg }};
    transform: translateY(-2px);
  }

  .footer-social-link-{{ block_id }} svg {
    width: calc({{ block.settings.social_icon_size }}px * 0.5);
    height: calc({{ block.settings.social_icon_size }}px * 0.5);
    fill: {{ block.settings.social_icon_color }};
  }

  .footer-heading-{{ block_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    margin-bottom: 15px;
  }

  .footer-links-{{ block_id }} {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-link-{{ block_id }} {
    color: {{ block.settings.link_color }};
    font-size: {{ block.settings.body_text_size }}px;
    text-decoration: none;
    transition: color 0.3s ease, padding-left 0.3s ease;
    display: inline-block;
  }

  .footer-link-{{ block_id }}:hover {
    color: {{ block.settings.link_hover_color }};
    padding-left: 5px;
  }

  .footer-newsletter-description-{{ block_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.body_text_size }}px;
    line-height: 1.5;
    margin-bottom: 15px;
  }

  .footer-newsletter-form-{{ block_id }} {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-input-{{ block_id }} {
    padding: 10px 14px;
    border: 1px solid {{ block.settings.input_border_color }};
    background-color: {{ block.settings.input_bg_color }};
    color: {{ block.settings.input_text_color }};
    font-size: {{ block.settings.body_text_size }}px;
    border-radius: {{ block.settings.input_border_radius }}px;
    outline: none;
    transition: border-color 0.3s ease;
  }

  .footer-input-{{ block_id }}::placeholder {
    color: {{ block.settings.input_placeholder_color }};
  }

  .footer-input-{{ block_id }}:focus {
    border-color: {{ block.settings.input_focus_border_color }};
  }

  .footer-submit-{{ block_id }},
  .footer-submit-{{ block_id }}:focus {
    width: 100%;
    padding: 12px 20px;
    background: {{ block.settings.submit_button_color }};
    border: 1px solid {{ block.settings.submit_button_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    color: #ffffff;
    font-size: {{ block.settings.body_text_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .footer-submit-{{ block_id }}:hover {
    background: {{ block.settings.submit_button_hover_color }};
    border-color: {{ block.settings.submit_button_hover_color }};
    color: #ffffff;
  }

  .footer-submit-arrow-{{ block_id }} {
    transition: transform 0.3s ease;
  }

  .footer-submit-{{ block_id }}:hover .footer-submit-arrow-{{ block_id }} {
    transform: translateX(4px);
  }

  .footer-bottom-{{ block_id }} {
    border-top: 1px solid {{ block.settings.divider_color }};
    padding: 20px 0;
    text-align: center;
  }

  .footer-copyright-{{ block_id }} {
    color: {{ block.settings.copyright_color }};
    font-size: {{ block.settings.copyright_size }}px;
    line-height: 1.5;
  }

  .footer-success-{{ block_id }} {
    color: {{ block.settings.success_message_color }};
    font-size: 13px;
    margin-top: 5px;
  }

  .footer-error-{{ block_id }} {
    color: {{ block.settings.error_message_color }};
    font-size: 13px;
    margin-top: 5px;
  }

  @media screen and (max-width: 989px) {
    .footer-columns-{{ block_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 25px;
    }
  }

  @media screen and (max-width: 749px) {
    .footer-{{ block_id }} {
      padding: 30px 0 0;
    }

    .footer-columns-{{ block_id }} {
      grid-template-columns: 1fr;
      gap: 25px;
      margin-bottom: 25px;
    }

    .footer-heading-{{ block_id }} {
      font-size: {{ block.settings.heading_size | times: 0.9 }}px;
    }

    .footer-brand-description-{{ block_id }},
    .footer-newsletter-description-{{ block_id }},
    .footer-link-{{ block_id }},
    .footer-input-{{ block_id }},
    .footer-submit-{{ block_id }} {
      font-size: {{ block.settings.body_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<footer-{{ block_id }} class="footer-{{ block_id }}" {{ block.shopify_attributes }}>
  <div class="footer-container-{{ block_id }}">
    <div class="footer-columns-{{ block_id }}">
      
      <div class="footer-column-{{ block_id }}">
        {% if block.settings.logo %}
          <div class="footer-logo-{{ block_id }}">
            <img
              src="{{ block.settings.logo | image_url: width: 400 }}"
              alt="{{ shop.name }}"
              loading="lazy"
              width="{{ block.settings.logo.width }}"
              height="{{ block.settings.logo.height }}"
            >
          </div>
        {% endif %}

        {% if block.settings.brand_description != blank %}
          <div class="footer-brand-description-{{ block_id }}">
            {{ block.settings.brand_description }}
          </div>
        {% endif %}

        <div class="footer-social-icons-{{ block_id }}">
          {% if block.settings.facebook_url != blank %}
            <a
              href="{{ block.settings.facebook_url }}"
              class="footer-social-link-{{ block_id }}"
              target="_blank"
              rel="noopener"
              aria-label="Facebook"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          {% endif %}

          {% if block.settings.instagram_url != blank %}
            <a
              href="{{ block.settings.instagram_url }}"
              class="footer-social-link-{{ block_id }}"
              target="_blank"
              rel="noopener"
              aria-label="Instagram"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          {% endif %}

          {% if block.settings.tiktok_url != blank %}
            <a
              href="{{ block.settings.tiktok_url }}"
              class="footer-social-link-{{ block_id }}"
              target="_blank"
              rel="noopener"
              aria-label="TikTok"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      <div class="footer-column-{{ block_id }}">
        {% if block.settings.quick_links_heading != blank %}
          <h3 class="footer-heading-{{ block_id }}">{{ block.settings.quick_links_heading }}</h3>
        {% endif %}
        <nav class="footer-links-{{ block_id }}">
          {% if block.settings.link_1_text != blank %}
            <a href="{{ block.settings.link_1_url }}" class="footer-link-{{ block_id }}">
              {{ block.settings.link_1_text }}
            </a>
          {% endif %}
          {% if block.settings.link_2_text != blank %}
            <a href="{{ block.settings.link_2_url }}" class="footer-link-{{ block_id }}">
              {{ block.settings.link_2_text }}
            </a>
          {% endif %}
          {% if block.settings.link_3_text != blank %}
            <a href="{{ block.settings.link_3_url }}" class="footer-link-{{ block_id }}">
              {{ block.settings.link_3_text }}
            </a>
          {% endif %}
          {% if block.settings.link_4_text != blank %}
            <a href="{{ block.settings.link_4_url }}" class="footer-link-{{ block_id }}">
              {{ block.settings.link_4_text }}
            </a>
          {% endif %}
        </nav>
      </div>

      <div class="footer-column-{{ block_id }}">
        {% if block.settings.services_heading != blank %}
          <h3 class="footer-heading-{{ block_id }}">{{ block.settings.services_heading }}</h3>
        {% endif %}
        <nav class="footer-links-{{ block_id }}">
          {% if block.settings.service_1_text != blank %}
            <a href="{{ block.settings.service_1_url }}" class="footer-link-{{ block_id }}">
              {{ block.settings.service_1_text }}
            </a>
          {% endif %}
          {% if block.settings.service_2_text != blank %}
            <a href="{{ block.settings.service_2_url }}" class="footer-link-{{ block_id }}">
              {{ block.settings.service_2_text }}
            </a>
          {% endif %}
          {% if block.settings.service_3_text != blank %}
            <a href="{{ block.settings.service_3_url }}" class="footer-link-{{ block_id }}">
              {{ block.settings.service_3_text }}
            </a>
          {% endif %}
          {% if block.settings.service_4_text != blank %}
            <a href="{{ block.settings.service_4_url }}" class="footer-link-{{ block_id }}">
              {{ block.settings.service_4_text }}
            </a>
          {% endif %}
        </nav>
      </div>

      <div class="footer-column-{{ block_id }}">
        {% if block.settings.newsletter_heading != blank %}
          <h3 class="footer-heading-{{ block_id }}">{{ block.settings.newsletter_heading }}</h3>
        {% endif %}
        {% if block.settings.newsletter_description != blank %}
          <div class="footer-newsletter-description-{{ block_id }}">
            {{ block.settings.newsletter_description }}
          </div>
        {% endif %}

        {% assign form_id = 'footer-newsletter-form-' | append: block_id %}
        {%- form 'customer' -%}
          <div class="{{ form_id }}">
            <input type="hidden" name="contact[tags]" value="newsletter">
            
            <input
              type="text"
              name="contact[first_name]"
              class="footer-input-{{ block_id }}"
              placeholder="{{ block.settings.name_placeholder }}"
              {% if form.errors %}
                aria-invalid="true"
              {% endif %}
            >

            <input
              type="email"
              name="contact[email]"
              class="footer-input-{{ block_id }}"
              placeholder="{{ block.settings.email_placeholder }}"
              required
              autocomplete="email"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="footer-error-{{ block_id }}"
              {% endif %}
              {% if form.posted_successfully? %}
                aria-describedby="footer-success-{{ block_id }}"
              {% endif %}
            >

            <button type="submit" class="footer-submit-{{ block_id }}">
              {{ block.settings.submit_button_text }}
              <span class="footer-submit-arrow-{{ block_id }}">→</span>
            </button>

            {%- if form.errors -%}
              <div id="footer-error-{{ block_id }}" class="footer-error-{{ block_id }}">
                {{ form.errors.messages.email }}
              </div>
            {%- endif -%}

            {%- if form.posted_successfully? -%}
              <div id="footer-success-{{ block_id }}" class="footer-success-{{ block_id }}">
                {{ block.settings.success_message }}
              </div>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>
    </div>

    <div class="footer-bottom-{{ block_id }}">
      <div class="footer-copyright-{{ block_id }}">
        {{ block.settings.copyright_text }}
      </div>
    </div>
  </div>
</footer-{{ block_id }}>

<script>
  (function() {
    class Footer{{ block_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('footer-{{ block_id }}', Footer{{ block_id }});
  })();
</script>

