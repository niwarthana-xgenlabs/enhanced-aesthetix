{% assign section_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .product-grid-{{ section_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .product-grid__container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .product-grid__heading-{{ section_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size_mobile }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 40px 0;
    text-align: left;
    line-height: 1.2;
  }

  .product-grid__grid-{{ section_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ block.settings.grid_gap_mobile }}px;
  }

  .product-card-{{ section_id }} {
    display: flex;
    flex-direction: column;
    background-color: transparent;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    color: inherit;
  }

  .product-card-{{ section_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }

  .product-card__image-wrapper-{{ section_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f9f9f9;
    margin-bottom: 16px;
  }

  .product-card__image-{{ section_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 1 / 1;
  }

  .product-card__image-placeholder-{{ section_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .product-card__image-placeholder-{{ section_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .product-card__content-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .product-card__title-{{ section_id }} {
    font-family: {{ block.settings.product_title_font.family }}, {{ block.settings.product_title_font.fallback_families }};
    font-weight: {{ block.settings.product_title_font.weight }};
    font-size: {{ block.settings.product_title_size_mobile }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0;
    line-height: 1.4;
    text-align: left;
  }

  .product-card__price-{{ section_id }} {
    font-family: {{ block.settings.price_font.family }}, {{ block.settings.price_font.fallback_families }};
    font-weight: {{ block.settings.price_font.weight }};
    font-size: {{ block.settings.price_size_mobile }}px;
    color: {{ block.settings.price_color }};
    margin: 0;
    text-align: left;
  }

  .product-card__button-{{ section_id }} {
    display: block;
    width: 100%;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-align: center;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    margin-top: 12px;
    font-family: inherit;
  }

  .product-card__button-{{ section_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  /* Modal Styles */
  .product-modal-overlay-{{ section_id }}:not(.active) {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  .product-modal-overlay-{{ section_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 9998;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    visibility: hidden;
  }

  .product-modal-overlay-{{ section_id }}.active {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .product-modal-{{ section_id }}:not(.active) {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  .product-modal-{{ section_id }} {
    display: none;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    width: 90%;
    max-width: 1100px;
    max-height: 90vh;
    background-color: #ffffff;
    border-radius: 16px;
    z-index: 9999;
    opacity: 0;
    transition: all 0.3s ease;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    flex-direction: column;
    pointer-events: none;
  }
  
  .product-modal-{{ section_id }}.active {
    display: flex;
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    pointer-events: auto;
    visibility: visible;
  }

  .product-modal-header-{{ section_id }} {
    padding: 20px 24px 16px;
    border-bottom: 1px solid #e0e0e0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
  }

  .product-modal-title-{{ section_id }} {
    font-size: 24px;
    font-weight: 700;
    color: #151515;
    margin: 0;
  }

  .product-modal-close-{{ section_id }} {
    background: none;
    border: none;
    font-size: 28px;
    color: #717171;
    cursor: pointer;
    padding: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all 0.3s ease;
  }

  .product-modal-close-{{ section_id }}:hover {
    background-color: #f5f5f5;
    color: #151515;
  }

  .product-modal-body-{{ section_id }} {
    padding: 20px 24px;
    flex: 1;
    overflow-y: auto;
    min-height: 0;
  }

  .product-modal-content-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .product-modal-loading-{{ section_id }} {
    text-align: center;
    padding: 40px;
    color: #717171;
  }

  .product-modal-info-{{ section_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    pointer-events: auto;
  }

  .product-modal-image-{{ section_id }} {
    width: 100%;
    max-height: 400px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    background-color: #f5f5f5;
  }

  .product-modal-image-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-modal-details-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    pointer-events: auto;
  }

  .product-modal-name-{{ section_id }} {
    font-size: 20px;
    font-weight: 700;
    color: #151515;
    margin: 0;
  }

  .product-modal-price-{{ section_id }} {
    font-size: 18px;
    font-weight: 600;
    color: #151515;
  }

  .product-variants-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    pointer-events: auto;
  }

  .product-variant-group-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
    pointer-events: auto;
  }

  .product-form-label-{{ section_id }} {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #151515;
    margin-bottom: 8px;
  }

  .product-variant-select-{{ section_id }},
  .product-form-input-{{ section_id }} {
    width: 100%;
    padding: 12px 40px 12px 16px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    font-size: 15px;
    font-family: inherit;
    transition: border-color 0.3s ease;
    background-color: #ffffff;
    cursor: pointer !important;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23151515' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 12px center;
    background-size: 18px;
  }
  
  select.product-variant-select-{{ section_id }} {
    pointer-events: auto !important;
    cursor: pointer !important;
    z-index: 1000 !important;
    position: relative;
  }

  .product-modal-{{ section_id }}.active select,
  .product-modal-{{ section_id }}.active input,
  .product-modal-{{ section_id }}.active button {
    pointer-events: auto !important;
    cursor: pointer !important;
  }

  .product-variant-select-{{ section_id }}:focus,
  .product-form-input-{{ section_id }}:focus {
    outline: none;
    border-color: {{ block.settings.button_background }};
  }

  .quantity-btn-{{ section_id }} {
    width: 40px;
    height: 40px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    background-color: #ffffff;
    cursor: pointer;
    font-size: 18px;
    font-weight: 600;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quantity-btn-{{ section_id }}:hover {
    border-color: {{ block.settings.button_background }};
    background-color: #f9f9f9;
  }

  .product-modal-footer-{{ section_id }} {
    padding: 16px 24px 20px;
    border-top: 1px solid #e0e0e0;
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    flex-shrink: 0;
  }

  .product-modal-button-{{ section_id }} {
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
    font-family: inherit;
  }

  .product-modal-button-cancel-{{ section_id }} {
    background-color: #f5f5f5;
    color: #151515;
  }

  .product-modal-button-cancel-{{ section_id }}:hover {
    background-color: #e0e0e0;
  }

  .product-modal-button-submit-{{ section_id }} {
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
  }

  .product-modal-button-submit-{{ section_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (min-width: 750px) {
    .product-grid-{{ section_id }} {
      padding: 80px 40px;
    }

    .product-grid__heading-{{ section_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
      margin-bottom: 50px;
    }

    .product-grid__grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.grid_gap_tablet }}px;
    }

    .product-card__title-{{ section_id }} {
      font-size: {{ block.settings.product_title_size_tablet }}px;
    }

    .product-card__price-{{ section_id }} {
      font-size: {{ block.settings.price_size_tablet }}px;
    }

    .product-modal-info-{{ section_id }} {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (min-width: 990px) {
    .product-grid__grid-{{ section_id }} {
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
      gap: {{ block.settings.grid_gap_desktop }}px;
    }

    .product-card__title-{{ section_id }} {
      font-size: {{ block.settings.product_title_size_desktop }}px;
    }

    .product-card__price-{{ section_id }} {
      font-size: {{ block.settings.price_size_desktop }}px;
    }
  }

  @media screen and (max-width: 750px) {
    .product-modal-{{ section_id }} {
      width: 95%;
      max-height: 92vh;
    }

    .product-modal-title-{{ section_id }} {
      font-size: 20px;
    }

    .product-modal-header-{{ section_id }},
    .product-modal-body-{{ section_id }},
    .product-modal-footer-{{ section_id }} {
      padding: 20px;
    }
  }
{% endstyle %}

<div class="product-grid-{{ section_id }}" {{ block.shopify_attributes }}>
  <div class="product-grid__container-{{ section_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="product-grid__heading-{{ section_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="product-grid__grid-{{ section_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign selected_product = block.settings[product_key]
        %}

        {% if selected_product != blank %}
          <div class="product-card-{{ section_id }}">
            <div class="product-card__image-wrapper-{{ section_id }}">
              {% if selected_product.featured_image %}
                <img
                  src="{{ selected_product.featured_image | image_url: width: 800 }}"
                  alt="{{ selected_product.featured_image.alt | default: selected_product.title | escape }}"
                  class="product-card__image-{{ section_id }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% else %}
                <div class="product-card__image-placeholder-{{ section_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="product-card__content-{{ section_id }}">
              {% if selected_product.title != blank %}
                <h3 class="product-card__title-{{ section_id }}">{{ selected_product.title }}</h3>
              {% endif %}

              {% if selected_product.price %}
                <p class="product-card__price-{{ section_id }}">{{ selected_product.price | money }}</p>
              {% endif %}

              <button 
                class="product-card__button-{{ section_id }}"
                data-product-trigger
                data-product-id="{{ selected_product.id }}"
                data-product-handle="{{ selected_product.handle }}"
                data-product-title="{{ selected_product.title | escape }}"
                data-product-price="{{ selected_product.price | money }}"
              >
                Add to Cart
              </button>
            </div>
          </div>
        {% else %}
          <div class="product-card-{{ section_id }}" style="cursor: default;">
            <div class="product-card__image-wrapper-{{ section_id }}">
              <div class="product-card__image-placeholder-{{ section_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- Product Selection Modal -->
  <div class="product-modal-overlay-{{ section_id }}" data-product-overlay></div>
  <div class="product-modal-{{ section_id }}" data-product-modal>
    <div class="product-modal-header-{{ section_id }}">
      <h3 class="product-modal-title-{{ section_id }}" data-product-title>Select Options</h3>
      <button class="product-modal-close-{{ section_id }}" data-product-close aria-label="Close modal">×</button>
    </div>
    <div class="product-modal-body-{{ section_id }}">
      <div class="product-modal-content-{{ section_id }}" data-product-content>
        <div class="product-modal-loading-{{ section_id }}" data-product-loading>
          <p>Loading product...</p>
        </div>
        <div class="product-modal-info-{{ section_id }}" data-product-info style="display: none;">
          <div class="product-modal-image-{{ section_id }}" data-product-image></div>
          <div class="product-modal-details-{{ section_id }}">
            <h4 class="product-modal-name-{{ section_id }}" data-product-name></h4>
            <div class="product-modal-price-{{ section_id }}" data-product-price></div>
            <form class="product-form-{{ section_id }}" data-product-form>
              <div class="product-variants-{{ section_id }}" data-product-variants></div>
              <div class="product-quantity-{{ section_id }}" style="margin-top: 12px;">
                <label class="product-form-label-{{ section_id }}">Quantity</label>
                <div style="display: flex; align-items: center; gap: 12px; margin-top: 6px;">
                  <button type="button" class="quantity-btn-{{ section_id }}" data-quantity-decrease>-</button>
                  <input 
                    type="number" 
                    class="product-form-input-{{ section_id }}" 
                    name="quantity" 
                    value="1" 
                    min="1" 
                    data-product-quantity
                    style="width: 80px; text-align: center;"
                  >
                  <button type="button" class="quantity-btn-{{ section_id }}" data-quantity-increase>+</button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
    <div class="product-modal-footer-{{ section_id }}">
      <button 
        type="button" 
        class="product-modal-button-{{ section_id }} product-modal-button-cancel-{{ section_id }}" 
        data-product-close
      >
        Cancel
      </button>
      <button 
        type="button" 
        class="product-modal-button-{{ section_id }} product-modal-button-submit-{{ section_id }}" 
        data-product-add-to-cart
        disabled
      >
        Add to Cart
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeProductGrid);
    } else {
      initializeProductGrid();
    }

    function initializeProductGrid() {
      const sectionId = '{{ section_id }}';
      const container = document.querySelector('.product-grid-{{ section_id }}');
      
      if (!container) return;
      
      const productTriggers = container.querySelectorAll('[data-product-trigger]');
      const productOverlay = container.querySelector('[data-product-overlay]');
      const productModal = container.querySelector('[data-product-modal]');
      const productCloseButtons = container.querySelectorAll('[data-product-close]');
      const productAddToCartBtn = container.querySelector('[data-product-add-to-cart]');
      const productLoading = container.querySelector('[data-product-loading]');
      const productInfo = container.querySelector('[data-product-info]');
      const productVariantsContainer = container.querySelector('[data-product-variants]');
      const productImageContainer = container.querySelector('[data-product-image]');
      const productNameEl = container.querySelector('[data-product-name]');
      const productPriceEl = container.querySelector('[data-product-price]');
      const productQuantityInput = container.querySelector('[data-product-quantity]');
      
      let currentProduct = null;
      let selectedVariant = null;
      let selectedOptions = {};

      // Fetch product data
      async function fetchProduct(handle) {
        try {
          const response = await fetch(`/products/${handle}.js`);
          if (!response.ok) throw new Error('Product not found');
          return await response.json();
        } catch (error) {
          console.error('Error fetching product:', error);
          return null;
        }
      }

      // Find variant by selected options
      function findVariant(product, options) {
        return product.variants.find(variant => {
          return product.options.every((option, index) => {
            return variant.options[index] === options[option.name];
          });
        });
      }

      // Update variant selection
      function updateVariantSelection() {
        if (!currentProduct) return;
        
        selectedVariant = findVariant(currentProduct, selectedOptions);
        
        if (selectedVariant) {
          if (productPriceEl) {
            const price = (selectedVariant.price / 100).toFixed(2);
            productPriceEl.textContent = `$${price}`;
          }
          
          if (productAddToCartBtn) {
            productAddToCartBtn.disabled = !selectedVariant.available;
          }
        } else {
          if (productAddToCartBtn) {
            productAddToCartBtn.disabled = true;
          }
        }
      }

      // Render product variants
      function renderVariants(product) {
        if (!productVariantsContainer || !product.options || product.options.length === 0) {
          productVariantsContainer.innerHTML = '';
          return;
        }

        let html = '';
        product.options.forEach((option, optionIndex) => {
          html += `
            <div class="product-variant-group-{{ section_id }}">
              <label class="product-form-label-{{ section_id }}">${option.name}</label>
              <select 
                class="product-variant-select-{{ section_id }}"
                data-option-name="${option.name}"
                data-variant-select
              >
                <option value="">Select ${option.name}</option>
          `;
          
          const uniqueValues = [...new Set(product.variants.map(v => v.options[optionIndex]))];
          uniqueValues.forEach(value => {
            const isSelected = selectedOptions[option.name] === value;
            html += `
              <option 
                value="${value}"
                ${isSelected ? 'selected' : ''}
              >
                ${value}
              </option>
            `;
          });
          
          html += `
              </select>
            </div>
          `;
        });

        productVariantsContainer.innerHTML = html;

        const variantSelects = productVariantsContainer.querySelectorAll('[data-variant-select]');
        variantSelects.forEach(select => {
          select.style.pointerEvents = 'auto';
          select.style.cursor = 'pointer';
          select.style.zIndex = '1000';
          
          select.addEventListener('change', function() {
            const optionName = this.getAttribute('data-option-name');
            const optionValue = this.value;
            
            if (optionValue) {
              selectedOptions[optionName] = optionValue;
            } else {
              delete selectedOptions[optionName];
            }
            
            updateVariantSelection();
          });
        });
      }

      // Load product into modal
      async function loadProduct(handle, productId) {
        if (productLoading) productLoading.style.display = 'block';
        if (productInfo) productInfo.style.display = 'none';
        
        try {
          const product = await fetchProduct(handle);
          if (!product) {
            alert('Product not found');
            closeProductModal();
            return;
          }

          if (!product.variants || !Array.isArray(product.variants) || product.variants.length === 0) {
            alert('Product has no variants available');
            closeProductModal();
            return;
          }

          currentProduct = product;
          selectedOptions = {};
          selectedVariant = null;

          if (productNameEl) productNameEl.textContent = product.title;
          if (productPriceEl) {
            const price = (product.variants[0].price / 100).toFixed(2);
            productPriceEl.textContent = `$${price}`;
          }
          if (productImageContainer) {
            productImageContainer.innerHTML = `
              <img 
                src="${product.featured_image || product.images[0] || ''}" 
                alt="${product.title}"
                loading="lazy"
              >
            `;
          }
          if (productQuantityInput) productQuantityInput.value = 1;

          renderVariants(product);

          if (productLoading) productLoading.style.display = 'none';
          if (productInfo) productInfo.style.display = 'grid';

          if (product.variants.length > 0 && product.options && product.options.length > 0) {
            const firstAvailableVariant = product.variants.find(v => v.available) || product.variants[0];
            if (firstAvailableVariant && firstAvailableVariant.options) {
              product.options.forEach((option, index) => {
                if (firstAvailableVariant.options[index]) {
                  selectedOptions[option.name] = firstAvailableVariant.options[index];
                }
              });
              updateVariantSelection();
              
              const variantSelects = productVariantsContainer.querySelectorAll('[data-variant-select]');
              variantSelects.forEach(select => {
                const optionName = select.getAttribute('data-option-name');
                const optionIndex = product.options.findIndex(o => o.name === optionName);
                
                if (optionIndex >= 0 && firstAvailableVariant.options[optionIndex]) {
                  select.value = firstAvailableVariant.options[optionIndex];
                }
              });
            }
          }
        } catch (error) {
          console.error('Error loading product:', error);
          alert('Error loading product. Please try again.');
          closeProductModal();
        }
      }

      // Open modal
      function openProductModal(trigger) {
        if (!trigger) return;
        
        const productHandle = trigger.getAttribute('data-product-handle');
        const productId = trigger.getAttribute('data-product-id');
        
        if (!productHandle) {
          alert('Product not configured');
          return;
        }

        if (productOverlay && productModal) {
          productOverlay.classList.add('active');
          productModal.classList.add('active');
          document.body.style.overflow = 'hidden';
          
          setTimeout(() => {
            const modalSelects = productModal.querySelectorAll('select');
            modalSelects.forEach(s => {
              s.style.pointerEvents = 'auto';
              s.style.cursor = 'pointer';
            });
          }, 100);
        }

        loadProduct(productHandle, productId);
      }

      // Close modal
      function closeProductModal() {
        if (productOverlay && productModal) {
          productOverlay.classList.remove('active');
          productModal.classList.remove('active');
          document.body.style.overflow = '';
        }
        currentProduct = null;
        selectedVariant = null;
        selectedOptions = {};
      }

      // Add to cart
      async function addToCart() {
        if (!selectedVariant || !currentProduct) {
          alert('Please select all options');
          return;
        }

        const quantity = productQuantityInput ? parseInt(productQuantityInput.value) : 1;
        
        if (productAddToCartBtn) {
          productAddToCartBtn.disabled = true;
          productAddToCartBtn.textContent = 'Adding...';
        }

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: selectedVariant.id,
              quantity: quantity
            })
          });

          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.description || 'Failed to add to cart');
          }

          window.location.href = '/cart';
        } catch (error) {
          console.error('Error adding to cart:', error);
          alert('Failed to add product to cart. Please try again.');
          if (productAddToCartBtn) {
            productAddToCartBtn.disabled = false;
            productAddToCartBtn.textContent = 'Add to Cart';
          }
        }
      }

      // Event listeners
      container.addEventListener('click', function(e) {
        const trigger = e.target.closest('[data-product-trigger]');
        if (trigger && !trigger.disabled) {
          e.preventDefault();
          openProductModal(trigger);
        }
      });

      productCloseButtons.forEach(button => {
        button.addEventListener('click', closeProductModal);
      });

      if (productOverlay) {
        productOverlay.addEventListener('click', function(e) {
          if (e.target === productOverlay) {
            closeProductModal();
          }
        });
      }

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && productModal && productModal.classList.contains('active')) {
          closeProductModal();
        }
      });

      if (productAddToCartBtn) {
        productAddToCartBtn.addEventListener('click', addToCart);
      }

      const quantityDecrease = container.querySelector('[data-quantity-decrease]');
      const quantityIncrease = container.querySelector('[data-quantity-increase]');
      
      if (quantityDecrease && productQuantityInput) {
        quantityDecrease.addEventListener('click', function() {
          const current = parseInt(productQuantityInput.value);
          if (current > 1) {
            productQuantityInput.value = current - 1;
          }
        });
      }

      if (quantityIncrease && productQuantityInput) {
        quantityIncrease.addEventListener('click', function() {
          const current = parseInt(productQuantityInput.value);
          productQuantityInput.value = current + 1;
        });
      }

      if (productModal) {
        productModal.addEventListener('click', function(e) {
          e.stopPropagation();
        });
      }
    }
  })();
</script>

