{% assign section_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .why-choose-{{ section_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .why-choose-container-{{ section_id }} {
    max-width: 1600px;
    margin: 0 auto;
  }

  .why-choose-header-{{ section_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.spacing_below_heading }}px;
  }

  .why-choose-title-{{ section_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.spacing_below_title }}px;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    line-height: 1.2;
  }

  .why-choose-subtitle-{{ section_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.5;
  }

  .why-choose-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  @media screen and (min-width: 750px) {
    .why-choose-{{ section_id }} {
      padding: {{ block.settings.padding_top_desktop }}px 40px {{ block.settings.padding_bottom_desktop }}px;
    }

    .why-choose-title-{{ section_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }

    .why-choose-subtitle-{{ section_id }} {
      font-size: {{ block.settings.subtitle_size_desktop }}px;
    }

    .why-choose-grid-{{ section_id }} {
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
      gap: {{ block.settings.grid_gap_desktop }}px;
    }
  }

  .why-choose-item-{{ section_id }} {
    text-align: {{ block.settings.item_alignment }};
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    transition: transform 0.3s ease;
  }

  .why-choose-item-{{ section_id }}:hover {
    transform: translateY(-2px);
  }

  .why-choose-icon-{{ section_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.spacing_below_icon }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .why-choose-icon-wrapper-{{ section_id }} {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background-color: {{ block.settings.icon_placeholder_color }};
    border: 2px solid {{ block.settings.icon_border_color }};
  }

  .why-choose-icon-placeholder-{{ section_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.icon_placeholder_color }};
    border: 2px solid {{ block.settings.icon_border_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .why-choose-icon-wrapper-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .why-choose-icon-placeholder-{{ section_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.5;
  }

  .why-choose-item-title-{{ section_id }} {
    font-size: {{ block.settings.item_title_size }}px;
    color: {{ block.settings.item_title_color }};
    margin: 0 0 {{ block.settings.spacing_below_item_title }}px;
    font-weight: 600;
  }

  .why-choose-item-text-{{ section_id }} {
    font-size: {{ block.settings.item_text_size }}px;
    color: {{ block.settings.item_text_color }};
    margin: 0;
    line-height: 1.45;
  }

  @media screen and (min-width: 750px) {
    .why-choose-icon-{{ section_id }} {
      width: {{ block.settings.icon_size_desktop }}px;
      height: {{ block.settings.icon_size_desktop }}px;
    }

    .why-choose-item-title-{{ section_id }} {
      font-size: {{ block.settings.item_title_size_desktop }}px;
    }

    .why-choose-item-text-{{ section_id }} {
      font-size: {{ block.settings.item_text_size_desktop }}px;
    }
  }
{% endstyle %}

<why-choose-{{ section_id }} class="why-choose-{{ section_id }}" {{ block.shopify_attributes }}>
  <div class="why-choose-container-{{ section_id }}">
    {% if block.settings.heading != blank or block.settings.subtitle != blank %}
      <div class="why-choose-header-{{ section_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="why-choose-title-{{ section_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <div class="why-choose-subtitle-{{ section_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="why-choose-grid-{{ section_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign icon_key = 'item_' | append: i | append: '_icon'
          assign title_key = 'item_' | append: i | append: '_title'
          assign text_key = 'item_' | append: i | append: '_text'
          assign enabled_key = 'item_' | append: i | append: '_enabled'

          assign icon = block.settings[icon_key]
          assign title = block.settings[title_key]
          assign text = block.settings[text_key]
          assign enabled = block.settings[enabled_key]
        %}

        {% if enabled %}
          <div class="why-choose-item-{{ section_id }}">
            <div class="why-choose-icon-{{ section_id }}">
              {% if icon != blank %}
                <div class="why-choose-icon-wrapper-{{ section_id }}">
                  <img
                    src="{{ icon | image_url: width: 200 }}"
                    alt="{{ title | escape }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                </div>
              {% else %}
                <div class="why-choose-icon-placeholder-{{ section_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            {% if title != blank %}
              <h3 class="why-choose-item-title-{{ section_id }}">{{ title }}</h3>
            {% endif %}
            {% if text != blank %}
              <div class="why-choose-item-text-{{ section_id }}">{{ text }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</why-choose-{{ section_id }}>

<script>
  (function() {
    class WhyChooseSection extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('why-choose-{{ section_id }}', WhyChooseSection);
  })();
</script>

