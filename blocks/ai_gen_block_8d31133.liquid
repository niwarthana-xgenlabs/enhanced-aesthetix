{% doc %}
  @prompt
    Create a section called Video Hover Cards.
    The section should include:
    
    A heading at the top that can be edited in the theme editor.
    
    A subtitle below the heading that can be edited.
    
    A responsive grid of cards, showing 2 to 4 per row depending on screen size.
    
    Each card should have a background image with centered title text.
    
    When a user hovers over a card, the image should switch to a video that plays automatically, muted, and looping.
    
    Each card should support an optional link so the entire card is clickable.
    
    All content (heading, subtitle, card images, videos, titles, and links) must be editable in the theme editor.
    
    The section should include spacing controls for top and bottom margins.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-hover-cards-{{ ai_gen_id }} {
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    max-width: {{ settings['layout-width'] }}px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  .ai-video-hover-cards__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-video-hover-cards__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;}

  .ai-video-hover-cards__subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
  }

  .ai-video-hover-cards__grid-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.card_gap }}px;
    grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
  }

  @media screen and (min-width: 750px) {
    .ai-video-hover-cards__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .ai-video-hover-cards__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    }
  }

  .ai-video-hover-card-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: {{ block.settings.card_aspect_ratio }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .ai-video-hover-card__media-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .ai-video-hover-card__video-{{ ai_gen_id }} {
    opacity: 0;
    pointer-events: none;
  }

  .ai-video-hover-card-{{ ai_gen_id }}:hover .ai-video-hover-card__video-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-video-hover-card-{{ ai_gen_id }}:hover .ai-video-hover-card__image-{{ ai_gen_id }} {
    opacity: 0;
  }

  .ai-video-hover-card__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .ai-video-hover-card__content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    text-align: center;
    width: 90%;
  }

  .ai-video-hover-card__title-{{ ai_gen_id }} {
    color: {{ block.settings.card_text_color }};
    font-size: {{ block.settings.card_title_size }}px;
    margin: 0;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .ai-video-hover-card__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-video-hover-card__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-video-hover-card__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }
{% endstyle %}

<video-hover-cards-{{ ai_gen_id }}
  class="ai-video-hover-cards-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-hover-cards__header-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-video-hover-cards__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.subtitle != blank %}
      <p class="ai-video-hover-cards__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
    {% endif %}
  </div>

  <div class="ai-video-hover-cards__grid-{{ ai_gen_id }}">
    {% for i in (1..8) %}
      {% liquid
        assign image_key = 'card_' | append: i | append: '_image'
        assign video_key = 'card_' | append: i | append: '_video'
        assign title_key = 'card_' | append: i | append: '_title'
        assign link_key = 'card_' | append: i | append: '_link'
        assign card_image = block.settings[image_key]
        assign card_video = block.settings[video_key]
        assign card_title = block.settings[title_key]
        assign card_link = block.settings[link_key]
      %}

      {% if card_image != blank or card_video != blank or card_title != blank %}
        {% if card_link != blank %}
          <a href="{{ card_link }}" class="ai-video-hover-card-{{ ai_gen_id }}">
        {% else %}
          <div class="ai-video-hover-card-{{ ai_gen_id }}">
        {% endif %}

          {% if card_image != blank %}
            <img
              src="{{ card_image | image_url: width: 800 }}"
              alt="{{ card_image.alt | escape }}"
              class="ai-video-hover-card__media-{{ ai_gen_id }} ai-video-hover-card__image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ card_image.width }}"
              height="{{ card_image.height }}"
            >
          {% else %}
            <div class="ai-video-hover-card__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-video-hover-card__empty-state-{{ ai_gen_id }}">
                Add an image
              </div>
            </div>
          {% endif %}

          {% if card_video != blank %}
            <video
              class="ai-video-hover-card__media-{{ ai_gen_id }} ai-video-hover-card__video-{{ ai_gen_id }}"
              muted
              loop
              playsinline
              preload="metadata"
            >
              {%- if card_video.sources -%}
                {%- for source in card_video.sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
              {%- endif -%}
            </video>
          {% endif %}

          <div class="ai-video-hover-card__overlay-{{ ai_gen_id }}"></div>

          {% if card_title != blank %}
            <div class="ai-video-hover-card__content-{{ ai_gen_id }}">
              <h3 class="ai-video-hover-card__title-{{ ai_gen_id }}">{{ card_title }}</h3>
            </div>
          {% endif %}{% if card_link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
</video-hover-cards-{{ ai_gen_id }}><script>
  (function() {
    class VideoHoverCards{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-video-hover-card-{{ ai_gen_id }}');
        this.setupVideoHover();
      }

      setupVideoHover() {
        this.cards.forEach(card => {
          const video = card.querySelector('.ai-video-hover-card__video-{{ ai_gen_id }}');
          
          if (video) {
            card.addEventListener('mouseenter', () => {
              video.currentTime = 0;
              video.play().catch(() => {});
            });

            card.addEventListener('mouseleave', () => {
              video.pause();
              video.currentTime = 0;
            });
          }
        });
      }
    }

    customElements.define('video-hover-cards-{{ ai_gen_id }}', VideoHoverCards{{ ai_gen_id }});
  })();
</script>

