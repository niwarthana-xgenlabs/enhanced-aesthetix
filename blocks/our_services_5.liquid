</style>

<script>
  (function() {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeServicesModal);
    } else {
      initializeServicesModal();
    }

    function initializeServicesModal() {
      const sectionId = '{{ services_id }}';
      const serviceCards = document.querySelectorAll('.services-grid__card-{{ services_id }}.has-product');
      const serviceOverlay = document.querySelector('[data-service-overlay]');
      const serviceModal = document.querySelector('[data-service-modal]');
      const serviceCloseButtons = document.querySelectorAll('[data-service-close]');
      const serviceAddToCartBtn = document.querySelector('[data-service-add-to-cart]');
      const serviceLoading = document.querySelector('[data-service-loading]');
      const serviceInfo = document.querySelector('[data-service-info]');
      const serviceVariantsContainer = document.querySelector('[data-service-variants]');
      const serviceNameEl = document.querySelector('[data-service-name]');
      const servicePriceEl = document.querySelector('[data-service-price]');
      const serviceDateInput = document.querySelector('[data-service-date]');
      const serviceTimeInput = document.querySelector('[data-service-time]');
      const calendarMonthEl = document.querySelector('[data-calendar-month]');
      const calendarGridEl = document.querySelector('[data-calendar-grid]');
      const calendarPrevBtn = document.querySelector('[data-calendar-prev]');
      const calendarNextBtn = document.querySelector('[data-calendar-next]');
      const timeSlotsContainer = document.querySelector('[data-time-slots]');
      const timezoneLabelEl = document.querySelector('[data-timezone-label]');
      
      let currentProduct = null;
      let selectedVariant = null;
      let selectedOptions = {};
      let calendarCurrentMonth = new Date();
      calendarCurrentMonth.setDate(1);
      let selectedDate = null;
      let selectedTimeSlot = null;

      // Fetch product data
      async function fetchProduct(handle) {
        try {
          const response = await fetch(`/products/${handle}.js`);
          if (!response.ok) throw new Error('Product not found');
          return await response.json();
        } catch (error) {
          console.error('Error fetching product:', error);
          return null;
        }
      }

      // Find variant by selected options
      function findVariant(product, options) {
        return product.variants.find(variant => {
          return product.options.every((option, index) => {
            return variant.options[index] === options[option.name];
          });
        });
      }

      // Update variant selection
      function updateVariantSelection() {
        if (!currentProduct) return;
        
        selectedVariant = findVariant(currentProduct, selectedOptions);
        
        if (selectedVariant) {
          if (servicePriceEl) {
            const price = (selectedVariant.price / 100).toFixed(2);
            servicePriceEl.textContent = `$${price}`;
          }
          
          if (serviceAddToCartBtn) {
            serviceAddToCartBtn.disabled = !selectedVariant.available;
          }
        } else {
          if (serviceAddToCartBtn) {
            serviceAddToCartBtn.disabled = true;
          }
        }
      }

      // Render product variants
      function renderVariants(product) {
        if (!serviceVariantsContainer || !product.options || product.options.length === 0) {
          serviceVariantsContainer.innerHTML = '';
          return;
        }

        let html = '';
        product.options.forEach((option, optionIndex) => {
          const optionLabel = option.name === 'Title' ? 'Variant' : option.name;
          html += `
            <div class="product-variant-group-{{ services_id }}">
              <label class="booking-form-label-{{ services_id }}">${optionLabel}</label>
              <select 
                class="product-variant-select-{{ services_id }}"
                data-option-name="${option.name}"
                data-variant-select
              >
                <option value="">Select ${optionLabel}</option>
          `;
          
          const uniqueValues = [...new Set(product.variants.map(v => v.options[optionIndex]))];
          uniqueValues.forEach(value => {
            const isSelected = selectedOptions[option.name] === value;
            html += `
              <option 
                value="${value}"
                ${isSelected ? 'selected' : ''}
              >
                ${value}
              </option>
            `;
          });
          
          html += `
              </select>
            </div>
          `;
        });

        serviceVariantsContainer.innerHTML = html;

        const variantSelects = serviceVariantsContainer.querySelectorAll('[data-variant-select]');
        variantSelects.forEach(select => {
          select.style.pointerEvents = 'auto';
          select.style.cursor = 'pointer';
          select.style.zIndex = '1000';
          
          select.addEventListener('change', function() {
            const optionName = this.getAttribute('data-option-name');
            const optionValue = this.value;
            
            if (optionValue) {
              selectedOptions[optionName] = optionValue;
            } else {
              delete selectedOptions[optionName];
            }
            
            updateVariantSelection();
          });
        });
      }

      function formatDateForValue(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
      }

      function renderCalendar() {
        if (!calendarGridEl || !calendarMonthEl) return;

        const today = new Date();
        today.setHours(0, 0, 0, 0);

        const year = calendarCurrentMonth.getFullYear();
        const month = calendarCurrentMonth.getMonth();

        const monthName = calendarCurrentMonth.toLocaleString(undefined, {
          month: 'long',
          year: 'numeric'
        });
        calendarMonthEl.textContent = monthName;

        calendarGridEl.innerHTML = '';

        const firstDay = new Date(year, month, 1);
        const firstWeekday = (firstDay.getDay() + 6) % 7; // make Monday = 0
        const daysInMonth = new Date(year, month + 1, 0).getDate();

        for (let i = 0; i < firstWeekday; i++) {
          const placeholder = document.createElement('div');
          placeholder.className = 'booking-calendar-day-{{ services_id }} muted';
          calendarGridEl.appendChild(placeholder);
        }

        for (let day = 1; day <= daysInMonth; day++) {
          const dateObj = new Date(year, month, day);
          dateObj.setHours(0, 0, 0, 0);
          const isoValue = formatDateForValue(dateObj);

          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = day;
          button.className = 'booking-calendar-day-{{ services_id }}';

          if (dateObj.getTime() === today.getTime()) {
            button.classList.add('today');
          }

          if (dateObj < today) {
            button.classList.add('muted');
            button.disabled = true;
          }

          if (serviceDateInput && serviceDateInput.value === isoValue) {
            button.classList.add('selected');
          }

          button.addEventListener('click', function() {
            const allDays = calendarGridEl.querySelectorAll('.booking-calendar-day-{{ services_id }}');
            allDays.forEach(d => d.classList.remove('selected'));
            button.classList.add('selected');

            selectedDate = dateObj;
            if (serviceDateInput) {
              serviceDateInput.value = isoValue;
            }
          });

          calendarGridEl.appendChild(button);
        }
      }

      function renderTimeSlots() {
        if (!timeSlotsContainer) return;

        const timeSlots = [
          '02:30 - 03:00',
          '03:00 - 03:30',
          '03:30 - 04:00',
          '04:00 - 04:30',
          '04:30 - 05:00',
          '05:00 - 05:30',
          '05:30 - 06:00',
          '06:00 - 06:30',
          '06:30 - 07:00',
          '07:00 - 07:30',
          '07:30 - 08:00',
          '08:00 - 08:30'
        ];

        timeSlotsContainer.innerHTML = '';

        timeSlots.forEach(slot => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'booking-time-slot-{{ services_id }}';
          button.innerHTML = `
            <span class="booking-time-slot-time-{{ services_id }}">${slot}</span>
            <span class="booking-time-slot-availability-{{ services_id }}">1 LEFT</span>
          `;

          button.addEventListener('click', function() {
            const allButtons = timeSlotsContainer.querySelectorAll('.booking-time-slot-{{ services_id }}');
            allButtons.forEach(b => b.classList.remove('selected'));
            button.classList.add('selected');

            selectedTimeSlot = slot;
            if (serviceTimeInput) {
              serviceTimeInput.value = slot;
            }
          });

          timeSlotsContainer.appendChild(button);
        });
      }

      // Load product into modal
      async function loadProduct(handle) {
        if (serviceLoading) serviceLoading.style.display = 'block';
        if (serviceInfo) serviceInfo.style.display = 'none';
        
        try {
          const product = await fetchProduct(handle);
          if (!product) {
            alert('Product not found');
            closeServiceModal();
            return;
          }

          if (!product.variants || !Array.isArray(product.variants) || product.variants.length === 0) {
            alert('Product has no variants available');
            closeServiceModal();
            return;
          }

          currentProduct = product;
          selectedOptions = {};
          selectedVariant = null;

          if (serviceNameEl) serviceNameEl.textContent = product.title;
          if (servicePriceEl) {
            const price = (product.variants[0].price / 100).toFixed(2);
            servicePriceEl.textContent = `$${price}`;
          }

          renderVariants(product);

          if (serviceLoading) serviceLoading.style.display = 'none';
          if (serviceInfo) serviceInfo.style.display = 'grid';

          if (product.variants.length > 0 && product.options && product.options.length > 0) {
            const firstAvailableVariant = product.variants.find(v => v.available) || product.variants[0];
            if (firstAvailableVariant && firstAvailableVariant.options) {
              product.options.forEach((option, index) => {
                if (firstAvailableVariant.options[index]) {
                  selectedOptions[option.name] = firstAvailableVariant.options[index];
                }
              });
              updateVariantSelection();
              
              const variantSelects = serviceVariantsContainer.querySelectorAll('[data-variant-select]');
              variantSelects.forEach(select => {
                const optionName = select.getAttribute('data-option-name');
                const optionIndex = product.options.findIndex(o => o.name === optionName);
                
                if (optionIndex >= 0 && firstAvailableVariant.options[optionIndex]) {
                  select.value = firstAvailableVariant.options[optionIndex];
                }
              });
            }
          }

          if (serviceDateInput) {
            serviceDateInput.value = '';
          }
          if (serviceTimeInput) {
            serviceTimeInput.value = '';
          }

          selectedDate = null;
          selectedTimeSlot = null;

          if (calendarGridEl) {
            const allDays = calendarGridEl.querySelectorAll('.booking-calendar-day-{{ services_id }}');
            allDays.forEach(d => d.classList.remove('selected'));
          }
          if (timeSlotsContainer) {
            const allButtons = timeSlotsContainer.querySelectorAll('.booking-time-slot-{{ services_id }}');
            allButtons.forEach(b => b.classList.remove('selected'));
          }
        } catch (error) {
          console.error('Error loading product:', error);
          alert('Error loading product. Please try again.');
          closeServiceModal();
        }
      }

      // Open modal
      function openServiceModal(handle) {
        if (!handle) {
          alert('Product not configured');
          return;
        }

        if (serviceOverlay && serviceModal) {
          serviceOverlay.classList.add('active');
          serviceModal.classList.add('active');
          document.body.style.overflow = 'hidden';
        }

        loadProduct(handle);
      }

      // Close modal
      function closeServiceModal() {
        if (serviceOverlay && serviceModal) {
          serviceOverlay.classList.remove('active');
          serviceModal.classList.remove('active');
          document.body.style.overflow = '';
        }
        currentProduct = null;
        selectedVariant = null;
        selectedOptions = {};
      }

      // Add to cart
      async function addToCart() {
        if (!selectedVariant || !currentProduct) {
          alert('Please select all options');
          return;
        }

        if (serviceDateInput && !serviceDateInput.value) {
          alert('Please select a date');
          return;
        }

        if (serviceTimeInput && !serviceTimeInput.value) {
          alert('Please select a time');
          return;
        }

        const quantity = 1;
        
        if (serviceAddToCartBtn) {
          serviceAddToCartBtn.disabled = true;
          serviceAddToCartBtn.textContent = 'Adding...';
        }

        try {
          const properties = {};
          if (serviceDateInput && serviceDateInput.value) {
            properties['Booking date'] = serviceDateInput.value;
          }
          if (serviceTimeInput && serviceTimeInput.value) {
            properties['Booking time'] = serviceTimeInput.value;
          }

          const payload = {
            id: selectedVariant.id,
            quantity: quantity
          };

          if (Object.keys(properties).length > 0) {
            payload.properties = properties;
          }

          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload)
          });

          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.description || 'Failed to add to cart');
          }

          window.location.href = '/cart';
        } catch (error) {
          console.error('Error adding to cart:', error);
          alert('Failed to add product to cart. Please try again.');
          if (serviceAddToCartBtn) {
            serviceAddToCartBtn.disabled = false;
            serviceAddToCartBtn.textContent = 'Add to Cart';
          }
        }
      }

      // Initialize calendar, time slots, and timezone
      if (timezoneLabelEl) {
        try {
          const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
          timezoneLabelEl.textContent = tz ? `${tz}` : 'Local time';
        } catch (e) {
          timezoneLabelEl.textContent = 'Local time';
        }
      }

      if (calendarPrevBtn) {
        calendarPrevBtn.addEventListener('click', function() {
          calendarCurrentMonth.setMonth(calendarCurrentMonth.getMonth() - 1);
          renderCalendar();
        });
      }

      if (calendarNextBtn) {
        calendarNextBtn.addEventListener('click', function() {
          calendarCurrentMonth.setMonth(calendarCurrentMonth.getMonth() + 1);
          renderCalendar();
        });
      }

      renderCalendar();
      renderTimeSlots();

      // Event listeners for service cards
      serviceCards.forEach(card => {
        card.addEventListener('click', function(e) {
          e.preventDefault();
          const productHandle = this.getAttribute('data-product-handle');
          if (productHandle) {
            openServiceModal(productHandle);
          }
        });
      });

      // Close button listeners
      serviceCloseButtons.forEach(button => {
        button.addEventListener('click', closeServiceModal);
      });

      // Overlay click to close
      if (serviceOverlay) {
        serviceOverlay.addEventListener('click', function(e) {
          if (e.target === serviceOverlay) {
            closeServiceModal();
          }
        });
      }

      // ESC key to close
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && serviceModal && serviceModal.classList.contains('active')) {
          closeServiceModal();
        }
      });

      // Add to cart button
      if (serviceAddToCartBtn) {
        serviceAddToCartBtn.addEventListener('click', addToCart);
      }

      // Prevent modal from closing when clicking inside
      if (serviceModal) {
        serviceModal.addEventListener('click', function(e) {
          e.stopPropagation();
        });
      }
    }
  })();
</script>

