  data-reel-10-price="{{ block.settings.reel_10_product.price }}"
  data-reel-10-url="{{ block.settings.reel_10_product.url }}"
  data-reel-10-image="{{ block.settings.reel_10_product.featured_image | image_url: width: 100 }}"
>
  <div class="shoppable-reels__container-{{ gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="shoppable-reels__heading-{{ gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="shoppable-reels__carousel-wrapper-{{ gen_id }}">
      <div class="shoppable-reels__carousel-{{ gen_id }}" data-carousel>
        {% assign first_item_processed = false %}
        {% for i in (1..10) %}
          {% liquid
            assign reel_enabled_key = 'reel_' | append: i | append: '_enabled'
            assign reel_image_key = 'reel_' | append: i | append: '_image'
            assign reel_video_key = 'reel_' | append: i | append: '_video'
            assign reel_product_key = 'reel_' | append: i | append: '_product'

            assign reel_enabled = block.settings[reel_enabled_key]
            assign reel_image = block.settings[reel_image_key]
            assign reel_video = block.settings[reel_video_key]
            assign reel_product = block.settings[reel_product_key]

            assign media_type = 'image'
            if reel_video != blank
              assign media_type = 'video'
            endif
          %}

          {% if reel_enabled %}
            {% liquid
              assign is_first_item = false
              unless first_item_processed
                assign is_first_item = true
                assign first_item_processed = true
              endunless
            %}
            <div
              class="shoppable-reels__item-{{ gen_id }}{% if is_first_item %} active{% endif %}"
              data-item-index="{{ forloop.index0 }}"
              data-reel-number="{{ i }}"
              data-original-index="{{ forloop.index0 }}"
              data-product-id="{{ reel_product.id }}"
              data-product-url="{{ reel_product.url }}"
              {% if reel_product.selected_or_first_available_variant %}
              data-variant-id="{{ reel_product.selected_or_first_available_variant.id }}"
              {% endif %}
            >
              <div class="shoppable-reels__media-wrapper-{{ gen_id }}" data-media-wrapper>
                {% if media_type == 'video' and reel_video != blank %}
                  <video
                    class="shoppable-reels__video-{{ gen_id }}"
                    data-video
                    loop
                    muted
                    playsinline
                    preload="metadata"
                  >
                    <source src="{{ reel_video }}" type="video/mp4">
                  </video>
                  <div class="shoppable-reels__play-icon-{{ gen_id }}" data-play-icon>
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                {% elsif reel_image != blank %}
                  <img
                    src="{{ reel_image | image_url: width: 600 }}"
                    alt="{{ reel_image.alt | escape }}"
                    class="shoppable-reels__media-{{ gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="shoppable-reels__placeholder-{{ gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                
              </div>

              <div class="shoppable-reels__item-info-{{ gen_id }}">
                {% if reel_product %}
                  <div class="shoppable-reels__item-product-image-{{ gen_id }}">
                    {% if reel_product.featured_image %}
                      <img
                        src="{{ reel_product.featured_image | image_url: width: 100 }}"
                        width="auto"
                        height="auto"
                        alt="{{ reel_product.featured_image.alt | escape }}"
                        loading="lazy"
                      >
                    {% else %}
                      <div class="shoppable-reels__item-product-placeholder-{{ gen_id }}">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>
                  <div class="shoppable-reels__item-title-{{ gen_id }}">
                    {{ reel_product.title }}
                  </div>
                  <div class="shoppable-reels__item-price-{{ gen_id }}">
                    {{ reel_product.price | money }}
                  </div>
                {% else %}
                  <div class="shoppable-reels__item-product-image-{{ gen_id }}">
                    <div class="shoppable-reels__item-product-placeholder-{{ gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  </div>
                  <div class="shoppable-reels__item-title-{{ gen_id }}">
                    Add product
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% assign enabled_count = 0 %}
      {% for i in (1..10) %}
        {% liquid
          assign reel_enabled_key = 'reel_' | append: i | append: '_enabled'
          assign reel_enabled = block.settings[reel_enabled_key]
          if reel_enabled
            assign enabled_count = enabled_count | plus: 1
          endif
        %}
      {% endfor %}

      {% if enabled_count > 1 %}
        <div class="shoppable-reels__nav-{{ gen_id }}" data-nav>
          {% assign first_nav_dot_processed = false %}
          {% for i in (1..10) %}
            {% liquid
              assign reel_enabled_key = 'reel_' | append: i | append: '_enabled'
              assign reel_enabled = block.settings[reel_enabled_key]
            %}
            {% if reel_enabled %}
              {% liquid
                assign is_first_nav_dot = false
                unless first_nav_dot_processed
                  assign is_first_nav_dot = true
                  assign first_nav_dot_processed = true
                endunless
              %}
              <div
                class="shoppable-reels__nav-dot-{{ gen_id }}{% if is_first_nav_dot %} active{% endif %}"
                data-nav-index="{{ forloop.index0 }}"
                data-reel-number="{{ i }}"
              ></div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Product Selection Modal -->
  <div class="product-modal-overlay-{{ gen_id }}" data-product-overlay-{{ gen_id }}></div>
  <div class="product-modal-{{ gen_id }}" data-product-modal-{{ gen_id }}>
    <div class="product-modal-header-{{ gen_id }}">
      <h3 class="product-modal-title-{{ gen_id }}" data-product-title-{{ gen_id }}>Product Details</h3>
      <button class="product-modal-close-{{ gen_id }}" data-product-close-{{ gen_id }} aria-label="Close modal">×</button>
    </div>
    <div class="product-modal-body-{{ gen_id }}">
      <div class="product-modal-content-{{ gen_id }}" data-product-content-{{ gen_id }}>
        <div class="product-modal-loading-{{ gen_id }}" data-product-loading-{{ gen_id }}>
          <p>Loading product...</p>
        </div>
        <div class="product-modal-info-{{ gen_id }}" data-product-info-{{ gen_id }} style="display: none;">
          <div class="product-modal-image-{{ gen_id }}" data-product-image-{{ gen_id }}></div>
          <div class="product-modal-details-{{ gen_id }}">
            <h4 class="product-modal-name-{{ gen_id }}" data-product-name-{{ gen_id }}></h4>
            <div class="product-modal-price-{{ gen_id }}" data-product-price-{{ gen_id }}></div>
            <form class="product-form-{{ gen_id }}" data-product-form-{{ gen_id }}>
              <div class="product-variants-{{ gen_id }}" data-product-variants-{{ gen_id }}></div>
              <div class="product-quantity-{{ gen_id }}">
                <label class="product-variant-label-{{ gen_id }}">Quantity</label>
                <div class="quantity-controls-{{ gen_id }}">
                  <button type="button" class="quantity-btn-{{ gen_id }}" data-quantity-decrease-{{ gen_id }}>-</button>
                  <input 
                    type="number" 
                    class="quantity-input-{{ gen_id }}" 
                    name="quantity" 
                    value="1" 
                    min="1" 
                    data-product-quantity-{{ gen_id }}
                  >
                  <button type="button" class="quantity-btn-{{ gen_id }}" data-quantity-increase-{{ gen_id }}>+</button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
    <div class="product-modal-footer-{{ gen_id }}">
      <button 
        type="button" 
        class="product-modal-button-{{ gen_id }} product-modal-cancel-{{ gen_id }}" 
        data-product-close-{{ gen_id }}
      >
        Cancel
      </button>
      <button 
        type="button" 
        class="product-modal-button-{{ gen_id }} product-modal-add-to-cart-{{ gen_id }}" 
        data-product-add-to-cart-{{ gen_id }}
        disabled
      >
        Add to Cart
      </button>
    </div>
  </div>
</shoppable-reels-{{ gen_id }}>

<script>
  (function() {
    class ShoppableReels{{ gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.carousel = this.querySelector('[data-carousel]');
        this.navDots = this.querySelectorAll('[data-nav-index]');
        this.currentIndex = 0;
        this.isDragging = false;
        this.startX = 0;
        this.scrollLeft = 0;
        this.originalItems = [];
        this.itemWidth = 0;
        this.gap = {{ block.settings.item_gap }};
        this.isScrolling = false;
        this.scrollRAF = null;
      }

      connectedCallback() {
        if (!this.carousel) return;

        this.originalItems = Array.from(this.carousel.querySelectorAll('[data-original-index]'));
        
        if (this.originalItems.length === 0) return;

        this.setupInfiniteScroll();
        this.setupDragScroll();
        this.setupVideoControls();
        this.setupNavigation();
        
        setTimeout(() => {
          this.centerThirdItem();
        }, 100);
      }

      setupInfiniteScroll() {
        const clonesBefore = this.originalItems.map(item => {
          const clone = item.cloneNode(true);
          clone.dataset.clone = 'before';
          return clone;
        });

        const clonesAfter = this.originalItems.map(item => {
          const clone = item.cloneNode(true);
          clone.dataset.clone = 'after';
          return clone;
        });

        clonesBefore.reverse().forEach(clone => {
          this.carousel.insertBefore(clone, this.carousel.firstChild);
        });

        clonesAfter.forEach(clone => {
          this.carousel.appendChild(clone);
        });

        this.allItems = Array.from(this.carousel.querySelectorAll('[data-item-index]'));
        
        this.carousel.addEventListener('scroll', () => {
          this.handleInfiniteScroll();
          
          if (!this.scrollRAF) {
            this.scrollRAF = requestAnimationFrame(() => {
              this.handleActiveItem();
              this.scrollRAF = null;
            });
          }
        }, { passive: true });

        this.setupVideoControlsForClones();
        this.setupItemClickHandlers();
        this.setupProductModal();
      }

      setupVideoControlsForClones() {
        const allPlayIcons = this.carousel.querySelectorAll('[data-play-icon]');
        allPlayIcons.forEach((playIcon) => {
          if (!playIcon.dataset.listenerAdded) {
            playIcon.dataset.listenerAdded = 'true';
            playIcon.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              e.stopImmediatePropagation();
              const video = playIcon.parentElement.querySelector('[data-video]');
              if (video) {
                if (video.paused) {
                  this.pauseAllVideos();
                  video.play();
                  playIcon.classList.add('playing');
                } else {
                  video.pause();
                  playIcon.classList.remove('playing');
                }
              }
            }, true);
          }
        });
      }

      centerThirdItem() {
        if (this.originalItems.length > 0) {
          // Center on the third item (index 2) of the original items
          // Since we have clones before, the actual index is originalItems.length + 2
          const targetIndex = this.originalItems.length + 2;
          this.scrollToItemByAbsoluteIndex(targetIndex, false);
          this.updateActiveItemByAbsoluteIndex(targetIndex);
        }
      }

      handleInfiniteScroll() {
        if (this.isScrolling || this.isDragging || !this.originalItems.length) return;

        const scrollLeft = this.carousel.scrollLeft;
        const itemWidth = this.originalItems[0].offsetWidth;
        const gap = this.gap;
        const itemTotalWidth = itemWidth + gap;
        const totalOriginalWidth = itemTotalWidth * this.originalItems.length;
        const containerWidth = this.carousel.offsetWidth;

        // Calculate boundaries (when to jump)
        const leftBoundary = itemTotalWidth * 1.5;
        const rightBoundary = totalOriginalWidth * 2 - containerWidth - itemTotalWidth * 1.5;

        // Jump to equivalent position when crossing boundaries
        if (scrollLeft < leftBoundary) {
          this.isScrolling = true;
          this.carousel.style.scrollBehavior = 'auto';
          this.carousel.scrollLeft = scrollLeft + totalOriginalWidth;
          requestAnimationFrame(() => {
            this.carousel.style.scrollBehavior = 'smooth';
            setTimeout(() => { this.isScrolling = false; }, 50);
          });
        } else if (scrollLeft > rightBoundary) {
          this.isScrolling = true;
          this.carousel.style.scrollBehavior = 'auto';
          this.carousel.scrollLeft = scrollLeft - totalOriginalWidth;
          requestAnimationFrame(() => {
            this.carousel.style.scrollBehavior = 'smooth';
            setTimeout(() => { this.isScrolling = false; }, 50);
          });
        }
      }

      handleActiveItem() {
        if (this.isDragging || this.isScrolling) return;

        let closestIndex = 0;
        let closestDistance = Infinity;
        const carouselCenter = this.carousel.scrollLeft + this.carousel.offsetWidth / 2;

        this.allItems.forEach((item, index) => {
          const itemLeft = item.offsetLeft;
          const itemCenter = itemLeft + item.offsetWidth / 2;
          const distance = Math.abs(carouselCenter - itemCenter);

          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });

        this.updateActiveItemByAbsoluteIndex(closestIndex);
      }

      setupDragScroll() {
        this.carousel.addEventListener('mousedown', (e) => this.startDragging(e));
        this.carousel.addEventListener('touchstart', (e) => this.startDragging(e), { passive: true });
        this.carousel.addEventListener('mousemove', (e) => this.drag(e));
        this.carousel.addEventListener('touchmove', (e) => this.drag(e), { passive: false });
        this.carousel.addEventListener('mouseup', () => this.stopDragging());
        this.carousel.addEventListener('mouseleave', () => this.stopDragging());
        this.carousel.addEventListener('touchend', () => this.stopDragging());
      }

      setupVideoControls() {
        this.originalItems.forEach((item) => {
          const mediaWrapper = item.querySelector('[data-media-wrapper]');
          const video = item.querySelector('[data-video]');
          const playIcon = item.querySelector('[data-play-icon]');

          if (video && playIcon) {
            // Only play icon should control video, not the whole wrapper
            // The wrapper click is handled by setupItemClickHandlers
          }
        });
      }

      setupNavigation() {
        this.navDots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const index = parseInt(dot.dataset.navIndex);
            const absoluteIndex = this.originalItems.length + index;
            this.scrollToItemByAbsoluteIndex(absoluteIndex, true);
          });
        });
      }

setupItemClickHandlers() {
  this.allItems.forEach((item, absoluteIndex) => {
    const mediaWrapper = item.querySelector('[data-media-wrapper]');
    if (!mediaWrapper) return;

    let clickStartTime = 0;
    let clickStartX = 0;
    let clickStartY = 0;
    let hasMoved = false;
    let clickStartScrollLeft = 0;

    const handleStart = (e) => {
      // Skip if clicking on play icon
      if (e.target && e.target.closest('[data-play-icon]')) {
        return;
      }
      
      clickStartTime = Date.now();
      const touch = e.type.includes('touch') ? e.touches[0] : e;
      clickStartX = touch.clientX;
      clickStartY = touch.clientY;
      clickStartScrollLeft = this.carousel.scrollLeft;
      hasMoved = false;
    };

    const handleMove = (e) => {
      if (clickStartTime === 0) return; // No start event was recorded
      
      const touch = e.type.includes('touch') ? e.touches[0] : e;
      const deltaX = Math.abs(touch.clientX - clickStartX);
      const deltaY = Math.abs(touch.clientY - clickStartY);
      const scrollDelta = Math.abs(this.carousel.scrollLeft - clickStartScrollLeft);
      
      // Mark as moved if there's significant movement or scroll
      if (deltaX > 10 || deltaY > 10 || scrollDelta > 5) {
        hasMoved = true;
      }
    };

    const handleEnd = (e) => {
      if (clickStartTime === 0) return; // No start event was recorded
      
      const clickDuration = Date.now() - clickStartTime;
      const scrollDelta = Math.abs(this.carousel.scrollLeft - clickStartScrollLeft);

      // Don't trigger if it was a drag/scroll
      if (hasMoved || scrollDelta > 5 || clickDuration > 500) {
        clickStartTime = 0;
        return;
      }

      // Don't trigger if clicking on video controls
      const target = e.target || (e.changedTouches && e.changedTouches[0] && document.elementFromPoint(e.changedTouches[0].clientX, e.changedTouches[0].clientY));
      if (target && target.closest('[data-play-icon]')) {
        clickStartTime = 0;
        return;
      }

      e.preventDefault();
      e.stopPropagation();

      // If item is active, open product modal
      if (item.classList.contains('active')) {
        const productId = item.dataset.productId;
        const productUrl = item.dataset.productUrl;
        if (productId && productUrl) {
          const urlParts = productUrl.split('/products/');
          if (urlParts.length > 1) {
            let handle = urlParts[1].split('?')[0].replace(/\/$/, '');
            if (handle) {
              this.openProductModal(handle);
            }
          }
        }
      } else {
        // If item is not active, scroll it to center
        this.scrollToItemByAbsoluteIndex(absoluteIndex, true);
      }
      
      clickStartTime = 0;
    };

    // Add click handlers to the entire item (includes media wrapper and product info)
    item.addEventListener('mousedown', handleStart, false);
    item.addEventListener('mousemove', handleMove, false);
    item.addEventListener('click', handleEnd, false);
    item.addEventListener('touchstart', handleStart, { passive: true });
    item.addEventListener('touchmove', handleMove, { passive: true });
    item.addEventListener('touchend', handleEnd, { passive: false });
  });
}

      setupProductModal() {
        const genId = '{{ gen_id }}';
        this.productModal = this.closest('shoppable-reels-{{ gen_id }}').querySelector(`[data-product-modal-${genId}]`);
        this.productOverlay = this.closest('shoppable-reels-{{ gen_id }}').querySelector(`[data-product-overlay-${genId}]`);
        this.productLoading = this.closest('shoppable-reels-{{ gen_id }}').querySelector(`[data-product-loading-${genId}]`);
        this.productInfo = this.closest('shoppable-reels-{{ gen_id }}').querySelector(`[data-product-info-${genId}]`);
        this.productImageContainer = this.closest('shoppable-reels-{{ gen_id }}').querySelector(`[data-product-image-${genId}]`);
        this.productNameEl = this.closest('shoppable-reels-{{ gen_id }}').querySelector(`[data-product-name-${genId}]`);
        this.productPriceEl = this.closest('shoppable-reels-{{ gen_id }}').querySelector(`[data-product-price-${genId}]`);
        this.productVariantsContainer = this.closest('shoppable-reels-{{ gen_id }}').querySelector(`[data-product-variants-${genId}]`);
        this.productQuantityInput = this.closest('shoppable-reels-{{ gen_id }}').querySelector(`[data-product-quantity-${genId}]`);
        this.productAddToCartBtn = this.closest('shoppable-reels-{{ gen_id }}').querySelector(`[data-product-add-to-cart-${genId}]`);
        
        this.currentProduct = null;
        this.selectedVariant = null;
        this.selectedOptions = {};

        // Close buttons
        const closeButtons = this.closest('shoppable-reels-{{ gen_id }}').querySelectorAll(`[data-product-close-${genId}]`);
        closeButtons.forEach(btn => {
          btn.addEventListener('click', () => this.closeProductModal());
        });

        // Overlay click
        if (this.productOverlay) {
          this.productOverlay.addEventListener('click', () => this.closeProductModal());
        }

        // Escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.productModal && this.productModal.classList.contains('active')) {
            this.closeProductModal();
          }
        });

        // Quantity controls
        const decreaseBtn = this.closest('shoppable-reels-{{ gen_id }}').querySelector(`[data-quantity-decrease-${genId}]`);
        const increaseBtn = this.closest('shoppable-reels-{{ gen_id }}').querySelector(`[data-quantity-increase-${genId}]`);
        
        if (decreaseBtn) {
          decreaseBtn.addEventListener('click', () => {
            const current = parseInt(this.productQuantityInput.value) || 1;
            if (current > 1) {
              this.productQuantityInput.value = current - 1;
            }
          });
        }

        if (increaseBtn) {
          increaseBtn.addEventListener('click', () => {
            const current = parseInt(this.productQuantityInput.value) || 1;
            this.productQuantityInput.value = current + 1;
          });
        }

        // Add to cart button
        if (this.productAddToCartBtn) {
          this.productAddToCartBtn.addEventListener('click', () => this.addProductToCart());
        }

        // Prevent modal close when clicking inside
        if (this.productModal) {
          this.productModal.addEventListener('click', (e) => {
            e.stopPropagation();
          });
        }
      }

      async openProductModal(handle) {
        if (this.productLoading) this.productLoading.style.display = 'block';
        if (this.productInfo) this.productInfo.style.display = 'none';
        
        // Show modal
        if (this.productOverlay) this.productOverlay.classList.add('active');
        if (this.productModal) this.productModal.classList.add('active');

        try {
          const response = await fetch(`/products/${handle}.js`);
          if (!response.ok) throw new Error('Product not found');
          
          const product = await response.json();
          this.currentProduct = product;
          this.selectedOptions = {};

          // Display product info
          if (this.productNameEl) this.productNameEl.textContent = product.title;
          
          // Display product image
          if (this.productImageContainer && product.featured_image) {
            this.productImageContainer.innerHTML = `<img src="${product.featured_image}" alt="${product.title}">`;
          }

          // Render variants
          this.renderVariants(product);

          // Auto-select first available variant
          if (product.variants && product.variants.length > 0 && product.options && product.options.length > 0) {
            const firstAvailableVariant = product.variants.find(v => v.available) || product.variants[0];
            if (firstAvailableVariant && firstAvailableVariant.options) {
              product.options.forEach((option, index) => {
                if (firstAvailableVariant.options[index]) {
                  this.selectedOptions[option.name] = firstAvailableVariant.options[index];
                }
              });
              this.selectedVariant = firstAvailableVariant;
              this.updatePrice();
              
              // Update select values
              const genId = '{{ gen_id }}';
              const variantSelects = this.productVariantsContainer.querySelectorAll(`[data-variant-select-${genId}]`);
              variantSelects.forEach(select => {
                const optionName = select.getAttribute('data-option-name');
                const optionIndex = product.options.findIndex(o => o.name === optionName);
                
                if (optionIndex >= 0 && firstAvailableVariant.options[optionIndex]) {
                  select.value = firstAvailableVariant.options[optionIndex];
                }
              });
              
              if (this.productAddToCartBtn) {
                this.productAddToCartBtn.disabled = !this.selectedVariant.available;
              }
            }
          }

          // Hide loading, show info
          if (this.productLoading) this.productLoading.style.display = 'none';
          if (this.productInfo) this.productInfo.style.display = 'grid';

        } catch (error) {
          console.error('Error loading product:', error);
          alert('Failed to load product');
          this.closeProductModal();
        }
      }

      closeProductModal() {
        if (this.productOverlay) this.productOverlay.classList.remove('active');
        if (this.productModal) this.productModal.classList.remove('active');
        this.currentProduct = null;
        this.selectedVariant = null;
        this.selectedOptions = {};
        if (this.productQuantityInput) this.productQuantityInput.value = 1;
      }

      renderVariants(product) {
        if (!this.productVariantsContainer || !product.options || product.options.length === 0) {
          if (this.productVariantsContainer) this.productVariantsContainer.innerHTML = '';
          return;
        }

        const genId = '{{ gen_id }}';
        let html = '';
        
        product.options.forEach((option, optionIndex) => {
          html += `
            <div class="product-variant-group-${genId}">
              <label class="product-variant-label-${genId}">${option.name}</label>
              <select 
                class="product-variant-select-${genId}"
                data-option-name="${option.name}"
                data-variant-select-${genId}
              >
                <option value="">Select ${option.name}</option>
          `;
          
          const uniqueValues = [...new Set(product.variants.map(v => v.options[optionIndex]))];
          uniqueValues.forEach(value => {
            const isSelected = this.selectedOptions[option.name] === value;
            html += `
              <option 
                value="${value}"
                ${isSelected ? 'selected' : ''}
              >
                ${value}
              </option>
            `;
          });
          
          html += `
              </select>
            </div>
          `;
        });

        this.productVariantsContainer.innerHTML = html;

        // Add event listeners to variant selects
        const variantSelects = this.productVariantsContainer.querySelectorAll(`[data-variant-select-${genId}]`);
        variantSelects.forEach(select => {
          select.addEventListener('change', () => {
            const optionName = select.getAttribute('data-option-name');
            const optionValue = select.value;
            
            if (optionValue) {
              // Update selected options
              this.selectedOptions[optionName] = optionValue;
            } else {
              // Remove option if "Select..." is chosen
              delete this.selectedOptions[optionName];
            }
            
            // Update variant selection
            this.updateVariantSelection();
          });
        });

        // Auto-select first available variant if only one option with one value
        if (product.options.length === 1) {
          const firstOptionUniqueValues = [...new Set(product.variants.map(v => v.options[0]))];
          if (firstOptionUniqueValues.length === 1) {
            this.selectedOptions[product.options[0].name] = firstOptionUniqueValues[0];
            const firstSelect = this.productVariantsContainer.querySelector(`[data-variant-select-${genId}]`);
            if (firstSelect) {
              firstSelect.value = firstOptionUniqueValues[0];
              this.updateVariantSelection();
            }
          }
        }
      }

      updateVariantSelection() {
        if (!this.currentProduct) return;
        
        this.selectedVariant = this.currentProduct.variants.find(variant => {
          return this.currentProduct.options.every((option, index) => {
            return variant.options[index] === this.selectedOptions[option.name];
          });
        });
        
        if (this.selectedVariant) {
          this.updatePrice();
          if (this.productAddToCartBtn) {
            this.productAddToCartBtn.disabled = !this.selectedVariant.available;
          }
        } else {
          if (this.productAddToCartBtn) {
            this.productAddToCartBtn.disabled = true;
          }
        }
      }

      updatePrice() {
        if (this.selectedVariant && this.productPriceEl) {
          const price = (this.selectedVariant.price / 100).toFixed(2);
          this.productPriceEl.textContent = `$${price}`;
        }
      }

      async addProductToCart() {
        if (!this.selectedVariant || !this.selectedVariant.available) return;

        const quantity = parseInt(this.productQuantityInput.value) || 1;
        const originalText = this.productAddToCartBtn.textContent;

        this.productAddToCartBtn.classList.add('adding');
        this.productAddToCartBtn.textContent = 'Adding...';
        this.productAddToCartBtn.disabled = true;

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              items: [{
                id: this.selectedVariant.id,
                quantity: quantity
              }]
            })
          });

          if (response.ok) {
            this.productAddToCartBtn.classList.remove('adding');
            this.productAddToCartBtn.classList.add('added');
            this.productAddToCartBtn.textContent = 'Added to Cart!';

            // Trigger cart refresh
            document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', {
              bubbles: true
            }));

            // Close modal after success
            setTimeout(() => {
              this.closeProductModal();
              this.productAddToCartBtn.classList.remove('added');
              this.productAddToCartBtn.textContent = originalText;
              this.productAddToCartBtn.disabled = false;
            }, 1500);
          } else {
            throw new Error('Failed to add to cart');
          }
        } catch (error) {
          console.error('Error adding to cart:', error);
          this.productAddToCartBtn.classList.remove('adding');
          this.productAddToCartBtn.textContent = 'Error - Try Again';

          setTimeout(() => {
            this.productAddToCartBtn.textContent = originalText;
            this.productAddToCartBtn.disabled = false;
          }, 2000);
        }
      }

startDragging(e) {
  this.isDragging = true;
  this.carousel.classList.add('dragging');
  this.carousel.style.scrollSnapType = 'none';
  const touch = e.type.includes('touch') ? e.touches[0] : e;
  this.startX = touch.pageX;
  this.scrollLeft = this.carousel.scrollLeft;
}

drag(e) {
  if (!this.isDragging) return;
  e.preventDefault();
  const touch = e.type.includes('touch') ? e.touches[0] : e;
  const x = touch.pageX;
  const walk = (x - this.startX) * 2;
  this.carousel.scrollLeft = this.scrollLeft - walk;
}

      stopDragging() {
        if (this.isDragging) {
          this.isDragging = false;
          this.carousel.classList.remove('dragging');
          
          // Re-enable scroll snap after a short delay
          setTimeout(() => {
            if (!this.isDragging) {
              this.carousel.style.scrollSnapType = 'x mandatory';
            }
          }, 50);
        }
      }

      scrollToItemByAbsoluteIndex(absoluteIndex, smooth = true) {
        const item = this.allItems[absoluteIndex];
        if (!item) return;

        const itemWidth = item.offsetWidth;
        const carouselWidth = this.carousel.offsetWidth;
        const scrollPosition = item.offsetLeft - (carouselWidth / 2) + (itemWidth / 2);

        if (smooth) {
          this.carousel.scrollTo({
            left: scrollPosition,
            behavior: 'smooth',
          });
        } else {
          this.carousel.scrollLeft = scrollPosition;
        }
      }

      updateActiveItemByAbsoluteIndex(absoluteIndex) {
        const item = this.allItems[absoluteIndex];
        if (!item) return;

        const originalIndex = parseInt(item.dataset.originalIndex);
        
        if (this.currentIndex === originalIndex) return;
        this.currentIndex = originalIndex;

        this.allItems.forEach((item) => {
          item.classList.remove('active');
        });
        
        this.allItems.forEach((item) => {
          if (parseInt(item.dataset.originalIndex) === originalIndex) {
            item.classList.add('active');
          }
        });

        this.navDots.forEach((dot, i) => {
          if (i === originalIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });

        this.pauseAllVideos();
      }

      pauseAllVideos() {
        const allVideos = this.carousel.querySelectorAll('[data-video]');
        allVideos.forEach((video) => {
          video.pause();
          const playIcon = video.parentElement.querySelector('[data-play-icon]');
          if (playIcon) playIcon.classList.remove('playing');
        });
      }
    }

    customElements.define('shoppable-reels-{{ gen_id }}', ShoppableReels{{ gen_id }});
  })();
</script>

