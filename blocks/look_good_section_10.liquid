{% assign section_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .hero-{{ section_id }} {
    display: block;
    position: relative;
    width: 100%;
    min-height: {{ block.settings.section_height_mobile }}px;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .hero-{{ section_id }} {
      min-height: {{ block.settings.section_height_desktop }}px;
    }
  }

  .hero-background-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-background-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position }};
  }

  .hero-background-placeholder-{{ section_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-background-placeholder-{{ section_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .hero-overlay-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .hero-container-{{ section_id }} {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    min-height: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
  }

  @media screen and (min-width: 750px) {
    .hero-container-{{ section_id }} {
      justify-content: flex-start;
      padding: 60px 80px;
    }
  }

  .hero-content-card-{{ section_id }} {
    background: {{ block.settings.card_background }};
    backdrop-filter: blur({{ block.settings.card_blur }}px);
    -webkit-backdrop-filter: blur({{ block.settings.card_blur }}px);
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding_mobile }}px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    max-width: 100%;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .hero-content-card-{{ section_id }} {
      max-width: {{ block.settings.card_max_width }}px;
      padding: {{ block.settings.card_padding_desktop }}px;
    }
  }

  .hero-heading-{{ section_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size_mobile }}px;
    font-weight: {{ block.settings.heading_weight }};
    line-height: 1.2;
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
  }

  @media screen and (min-width: 750px) {
    .hero-heading-{{ section_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }
  }

  .hero-text-{{ section_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size_mobile }}px;
    line-height: {{ block.settings.text_line_height }};
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    opacity: {{ block.settings.text_opacity | divided_by: 100.0 }};
  }

  @media screen and (min-width: 750px) {
    .hero-text-{{ section_id }} {
      font-size: {{ block.settings.text_size_desktop }}px;
    }
  }

  .hero-text-{{ section_id }}:last-of-type {
    margin-bottom: {{ block.settings.buttons_spacing }}px;
  }

  .hero-buttons-{{ section_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.button_gap }}px;
    align-items: center;
  }

  .hero-button-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
  }

  .hero-button-primary-{{ section_id }} {
    background-color: {{ block.settings.button_primary_bg }};
    color: {{ block.settings.button_primary_color }};
  }

  .hero-button-primary-{{ section_id }}:hover {
    background-color: {{ block.settings.button_primary_bg_hover }};
    color: {{ block.settings.button_primary_color_hover }};
  }

  .hero-button-secondary-{{ section_id }} {
    background-color: {{ block.settings.button_secondary_bg }};
    color: {{ block.settings.button_secondary_color }};
  }

  .hero-button-secondary-{{ section_id }}:hover {
    background-color: {{ block.settings.button_secondary_bg_hover }};
    color: {{ block.settings.button_secondary_color_hover }};
  }

  .hero-arrow-icon-{{ section_id }} {
    width: 16px;
    height: 16px;
    display: inline-block;
  }
{% endstyle %}

<hero-section-{{ section_id }} class="hero-{{ section_id }}" {{ block.shopify_attributes }}>
  <div class="hero-background-{{ section_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        srcset="{{ block.settings.background_image | image_url: width: 750 }} 750w,
                {{ block.settings.background_image | image_url: width: 1500 }} 1500w,
                {{ block.settings.background_image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="hero-background-placeholder-{{ section_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  {% if block.settings.overlay_opacity > 0 %}
    <div class="hero-overlay-{{ section_id }}"></div>
  {% endif %}

  <div class="hero-container-{{ section_id }}">
    <div class="hero-content-card-{{ section_id }}">
      {% if block.settings.heading != blank %}
        <h1 class="hero-heading-{{ section_id }}">{{ block.settings.heading }}</h1>
      {% endif %}

      {% if block.settings.text_paragraph_1 != blank %}
        <div class="hero-text-{{ section_id }}">{{ block.settings.text_paragraph_1 }}</div>
      {% endif %}

      {% if block.settings.text_paragraph_2 != blank %}
        <div class="hero-text-{{ section_id }}">{{ block.settings.text_paragraph_2 }}</div>
      {% endif %}

      <div class="hero-buttons-{{ section_id }}">
        {% if block.settings.button_primary_label != blank %}
          <a
            href="{{ block.settings.button_primary_link }}"
            class="hero-button-{{ section_id }} hero-button-primary-{{ section_id }}"
          >
            {{ block.settings.button_primary_label }}
          </a>
        {% endif %}

        {% if block.settings.button_secondary_label != blank %}
          <a
            href="{{ block.settings.button_secondary_link }}"
            class="hero-button-{{ section_id }} hero-button-secondary-{{ section_id }}"
          >
            {{ block.settings.button_secondary_label }}
            {% if block.settings.show_arrow_icon %}
              <span class="hero-arrow-icon-{{ section_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </span>
            {% endif %}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</hero-section-{{ section_id }}>

<script>
  (function() {
    class HeroSection{{ section_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustHeight();
        window.addEventListener('resize', () => this.adjustHeight());
      }

      adjustHeight() {
        const minHeight = window.innerWidth >= 750 
          ? '{{ block.settings.section_height_desktop }}px' 
          : '{{ block.settings.section_height_mobile }}px';
        this.style.minHeight = minHeight;
      }
    }

    customElements.define('hero-section-{{ section_id }}', HeroSection{{ section_id }});
  })();
</script>

