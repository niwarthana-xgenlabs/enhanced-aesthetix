{% assign section_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .concern-section-{{ section_id }} {
    display: block;
    width: 100%;
    padding: 80px 40px;
    background-color: {{ block.settings.background_color }};
  }

  .concern-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .concern-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 0 50px;
  }

  .concern-heading-{{ section_id }} {
    text-align: left;
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
  }

  .concern-explore-all-{{ section_id }} {
    font-size: {{ block.settings.explore_all_size }}px;
    color: {{ block.settings.explore_all_color }};
    text-decoration: none;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: 400;
    transition: color 0.3s ease;
  }

  .concern-explore-all-{{ section_id }}:hover {
    color: {{ block.settings.explore_all_hover_color }};
  }

  .concern-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .concern-card-{{ section_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .concern-card-{{ section_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }

  .concern-image-wrapper-{{ section_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
  }

  .concern-image-{{ section_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .concern-placeholder-{{ section_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .concern-placeholder-{{ section_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .concern-content-{{ section_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .concern-label-{{ section_id }} {
    font-size: {{ block.settings.label_size }}px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: {{ block.settings.label_color }};
    margin: 0 0 12px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: 500;
  }

  .concern-title-{{ section_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    line-height: 1.3;
  }

  .concern-description-{{ section_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.6;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    flex-grow: 1;
    flex-shrink: 0;
  }

  .concern-link-wrapper-{{ section_id }} {
    margin-top: 8px;
    flex-shrink: 0;
  }

  .concern-link-{{ section_id }} {
    display: inline-block;
    font-size: {{ block.settings.link_size }}px;
    color: #724C29;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: color 0.3s ease, text-decoration-color 0.3s ease;
  }

  .concern-link-{{ section_id }}:hover {
    color: {{ block.settings.link_hover_color }};
    text-decoration-color: {{ block.settings.link_hover_color }};
  }

  @media screen and (max-width: 989px) {
    .concern-section-{{ section_id }} {
      padding: 60px 30px;
    }

    .concern-heading-{{ section_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .concern-header-{{ section_id }} {
      margin-bottom: 40px;
    }

    .concern-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.card_gap | times: 0.8 }}px;
    }

    .concern-title-{{ section_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.9);
    }

    .concern-content-{{ section_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .concern-section-{{ section_id }} {
      padding: 50px 20px;
    }

    .concern-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
      margin-bottom: 30px;
    }

    .concern-heading-{{ section_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .concern-explore-all-{{ section_id }} {
      font-size: calc({{ block.settings.explore_all_size }}px * 0.9);
    }

    .concern-grid-{{ section_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_gap | times: 0.7 }}px;
    }

    .concern-title-{{ section_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.85);
    }

    .concern-description-{{ section_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.95);
    }

    .concern-content-{{ section_id }} {
      padding: {{ block.settings.card_padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<concern-section-{{ section_id }} class="concern-section-{{ section_id }}" {{ block.shopify_attributes }}>
  <div class="concern-container-{{ section_id }}">
    <div class="concern-header-{{ section_id }}">
      {% if block.settings.section_heading != blank %}
        <h2 class="concern-heading-{{ section_id }}">{{ block.settings.section_heading }}</h2>
      {% endif %}
      
      {% if block.settings.explore_all_text != blank and block.settings.explore_all_link != blank %}
        <a href="{{ block.settings.explore_all_link }}" class="concern-explore-all-{{ section_id }}">
          {{ block.settings.explore_all_text }}
        </a>
      {% endif %}
    </div>

    <div class="concern-grid-{{ section_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign collection_key = 'card_' | append: i | append: '_collection'
          assign card_collection = block.settings[collection_key]

          assign card_image = nil
          assign card_title = ''
          assign card_description = ''
          assign card_link = '#'

          if card_collection != blank
            assign card_image = card_collection.image | default: card_collection.products.first.featured_image
            assign card_title = card_collection.title
            assign card_description = card_collection.description | strip_html | truncate: 120
            assign card_link = card_collection.url
          endif
        %}

        <div class="concern-card-{{ section_id }}">
          <div class="concern-image-wrapper-{{ section_id }}">
            {% if card_image %}
              <img
                src="{{ card_image | image_url: width: 800 }}"
                alt="{{ card_image.alt | default: card_title | escape }}"
                loading="lazy"
                width="{{ card_image.width }}"
                height="{{ card_image.height }}"
                class="concern-image-{{ section_id }}"
              >
            {% else %}
              <div class="concern-placeholder-{{ section_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="concern-content-{{ section_id }}">
            <p class="concern-label-{{ section_id }}">{{ block.settings.card_label }}</p>

            {% if card_title != blank %}
              <h3 class="concern-title-{{ section_id }}">{{ card_title }}</h3>
            {% endif %}

            {% if card_description != blank %}
              <p class="concern-description-{{ section_id }}">{{ card_description }}</p>
            {% endif %}

            <div class="concern-link-wrapper-{{ section_id }}">
              <a href="{{ card_link | default: '#' }}" class="concern-link-{{ section_id }}">
                {{ block.settings.link_text }}
              </a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</concern-section-{{ section_id }}>

<script>
  (function() {
    class ConcernSection{{ section_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.concern-card-{{ section_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.cards.forEach((card) => {
          const link = card.querySelector('.concern-link-{{ section_id }}');
          if (link) {
            card.setAttribute('role', 'article');
          }
        });
      }
    }

    customElements.define('concern-section-{{ section_id }}', ConcernSection{{ section_id }});
  })();
</script>

