{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{% assign background_section_rgb = section.settings['section-color-overlay'] | color_to_rgb %}
{% assign heading_rgb = section.settings['section-color-body-text'] | color_to_rgb %}

{% assign background_rgb = section.settings['color-overlay'] | color_to_rgb %}
{% assign text_rgb = section.settings['color-body-text'] | color_to_rgb %}

<style>
    section[id="shopify-section-{{ section.id }}"]{
        {% if background_section_rgb != 'rgba(0, 0, 0, 0.0)' %}
            --color-overlay-rgb: {{ section.settings.section-color-overlay | color_to_rgb | remove: 'rgb(' | remove: ')' }};
            --color-overlay-opacity: {{ section.settings.section-color-overlay-opacity | divided_by: 100.0 }};
        {% endif %}
    }

    section[id="shopify-section-{{ section.id }}"] .headline__title{
      {% if heading_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-custom-text: {{ section.settings.section-color-body-text }};
      {% endif %}
    }
  [data-section-id="{{ section.id }}"]
  {
      {% comment %} Right side (text container) background: always white {% endcomment %}
        --color-overlay-rgb: 255, 255, 255;
        --color-overlay-opacity: 1;

      {% if section.settings.full-width-enabled %}
        --border-radius: 0;
      {% endif %}

      {% if section.settings.margin-top %}
        --section-gap-top: {{ section.settings.margin-top }}px;
      {% endif %}

      {% if section.settings.margin-bottom %}
        --section-gap-bottom: {{ section.settings.margin-bottom }}px;
      {% endif %}

      --desktop-percentage-image-width: {{ section.settings.desktop-percentage-image-width }}%;

    {% if section.settings.slide_height == 'fixed_height' %}
    --section-height: {{ section.settings.mobile_fixed_height }}px;
    --section-height-desk: {{ section.settings.desktop_fixed_height }}px;
    {% endif %}

    {% if section.settings.slide_height == 'adapt_to_first_image' %}
        --first-slide-ratio: {{ section.blocks.first.settings.mobile_image.aspect_ratio | default: 1 }};
        --first-slide-ratio-desk: {{ section.blocks.first.settings.desktop_image.aspect_ratio | default: 2.5 }};
    {% endif %}

  }

  [data-section-id="{{ section.id }}"] .hero
    {
        {% comment %} About Us: heading and body text in black (Welcome is styled gold via subheading block) {% endcomment %}
        --color-custom-text: #000000;
    }

  {% comment %} Welcome text in gold #B4975A {% endcomment %}
  {%- for block in section.blocks -%}
  {%- if block.type == 'subheading' -%}
  [data-section-id="{{ section.id }}"] [data-block-id="{{ block.id }}"] {
    color: #B4975A !important;
  }
  {%- endif -%}
  {%- endfor -%}

  {%- for block in section.blocks -%}
  [data-block-id="{{ block.id }}"]
  {

        --font-headline-scale-desk: {{ block.settings.size_heading | divided_by: 100.0 }};
        --font-headline-scale: {{ block.settings.size_heading_mobile | divided_by: 100.0 }};

        {% if block.type == 'countdown_timer' %}
        --font-timer-scale-desk: {{ block.settings.scale_timer | divided_by: 100.0 }};
        --font-timer-scale: {{ block.settings.scale_timer_mobile | divided_by: 100.0 }};
        --font-timer: {% if block.settings.timer_style == 'headline' %}var(--font-headline){% endif %}
        {% endif %}

        {% if block.type == 'text' and block.settings.text_style == 'subtitle' %}
            --font-base: var(--font-headline);
        {% endif %}
  }
  {%- endfor -%}

  {% comment %} Two rows: minimal gap so sections sit closer; clean junction where they meet {% endcomment %}
  [data-section-id="{{ section.id }}"] .image-with-text__rows .image-with-text__row {
    margin-bottom: 0;
  }
  [data-section-id="{{ section.id }}"] .image-with-text__rows .image-with-text__row + .image-with-text__row {
    margin-top: 0;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }
  [data-section-id="{{ section.id }}"] .image-with-text__rows .hero__media img,
  [data-section-id="{{ section.id }}"] .image-with-text__rows .hero__content {
    display: block;
    vertical-align: top;
  }
  @media screen and (max-width: 749px) {
    [data-section-id="{{ section.id }}"] .hero.hero--grid,
    [data-section-id="{{ section.id }}"] .hero.hero--grid--rev {
      grid-template-columns: 1fr !important;
      min-height: var(--section-height, 460px) !important;
    }
    [data-section-id="{{ section.id }}"] .hero.hero--grid .hero__media,
    [data-section-id="{{ section.id }}"] .hero.hero--grid--rev .hero__media {
      min-height: 200px;
    }
    [data-section-id="{{ section.id }}"] .hero.hero--grid--rev {
      display: flex !important;
      flex-direction: column-reverse !important;
    }
  }
</style>

{% comment %} Image always on left; text/content on right with white background {% endcomment %}
  {% assign customclass = 'hero--grid' %}

{% if section.settings['full-width-enabled'] %}
  {% assign customwrapperclass = 'hero__wrapper--full' %}
{% else %}
  {% assign customwrapperclass = 'hero__wrapper' %}
{% endif %}

<div
  data-section-id="{{ section.id }}"
  class="{{ customwrapperclass }}  {% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %}"
>
  <div class="{% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %} image-with-text__rows">
    {% if section.settings.content_heading != blank or section.settings.content_description != blank or section.settings.content_subheading != blank or section.settings.content_heading_2 != blank or section.settings.content_description_2 != blank or section.settings.content_subheading_2 != blank %}
      {% comment %} Section 1: Image first, then text {% endcomment %}
      <div class="hero {{ customclass }} image-with-text__row" style="display: grid; grid-template-columns: var(--desktop-percentage-image-width, 50%) 1fr; min-height: var(--section-height-desk, 320px);">
        <div class="hero__media" style="position: relative; overflow: hidden;">
          {% if section.settings.desktop_image != blank %}
            <picture>
              {% if section.settings.mobile_image != blank %}
                <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 800 }}">
              {% endif %}
              <img
                src="{{ section.settings.desktop_image | image_url: width: 1200 }}"
                alt="{{ section.settings.desktop_image.alt | escape }}"
                width="{{ section.settings.desktop_image.width }}"
                height="{{ section.settings.desktop_image.height }}"
                loading="lazy"
                style="width: 100%; height: 100%; object-fit: cover; display: block;"
              >
            </picture>
          {% else %}
            <div style="width: 100%; height: 100%; min-height: 300px; background: #f0f0f0; display: flex; align-items: center; justify-content: center; color: #999;">{{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {% endif %}
        </div>
        <div class="hero__content hero__content--overlay" style="background: rgba(var(--color-overlay-rgb, 255, 255, 255), var(--color-overlay-opacity, 1)); color: var(--color-custom-text, #000); padding: 2rem; display: flex; flex-direction: column; justify-content: center;">
          <div class="hero__content-inner">
            {% if section.settings.content_subheading != blank %}
              <p class="hero__subheading" style="color: #B4975A; margin: 0 0 0.5rem; font-size: 1.1em;">{{ section.settings.content_subheading }}</p>
            {% endif %}
            {% if section.settings.content_heading != blank %}
              <h2 class="hero__title h0" style="color: inherit; margin: 0 0 1rem;">{{ section.settings.content_heading }}</h2>
            {% endif %}
            {% if section.settings.content_description != blank %}
              <div class="hero__text rte" style="color: inherit;">{{ section.settings.content_description }}</div>
            {% endif %}
          </div>
        </div>
      </div>
      {% comment %} Section 2: Text first, then image (different content) {% endcomment %}
      <div class="hero hero--grid hero--grid--rev image-with-text__row" style="display: grid; grid-template-columns: 1fr var(--desktop-percentage-image-width, 50%); min-height: var(--section-height-desk, 320px);">
        <div class="hero__content hero__content--overlay" style="background: rgba(var(--color-overlay-rgb, 255, 255, 255), var(--color-overlay-opacity, 1)); color: var(--color-custom-text, #000); padding: 2rem; display: flex; flex-direction: column; justify-content: center;">
          <div class="hero__content-inner">
            {% if section.settings.content_subheading_2 != blank %}
              <p class="hero__subheading" style="color: #B4975A; margin: 0 0 0.5rem; font-size: 1.1em;">{{ section.settings.content_subheading_2 }}</p>
            {% endif %}
            {% if section.settings.content_heading_2 != blank %}
              <h2 class="hero__title h0" style="color: inherit; margin: 0 0 1rem;">{{ section.settings.content_heading_2 }}</h2>
            {% endif %}
            {% if section.settings.content_description_2 != blank %}
              <div class="hero__text rte" style="color: inherit;">{{ section.settings.content_description_2 }}</div>
            {% endif %}
          </div>
        </div>
        <div class="hero__media" style="position: relative; overflow: hidden;">
          {% if section.settings.desktop_image_2 != blank %}
            <picture>
              {% if section.settings.mobile_image_2 != blank %}
                <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image_2 | image_url: width: 800 }}">
              {% endif %}
              <img
                src="{{ section.settings.desktop_image_2 | image_url: width: 1200 }}"
                alt="{{ section.settings.desktop_image_2.alt | escape }}"
                width="{{ section.settings.desktop_image_2.width }}"
                height="{{ section.settings.desktop_image_2.height }}"
                loading="lazy"
                style="width: 100%; height: 100%; object-fit: cover; display: block;"
              >
            </picture>
          {% else %}
            <div style="width: 100%; height: 100%; min-height: 300px; background: #f0f0f0; display: flex; align-items: center; justify-content: center; color: #999;">{{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {% endif %}
        </div>
      </div>
    {% else %}
      {% comment %} Fallback: use blocks (heading + text blocks) via hero snippet {% endcomment %}
      {% render 'hero',
        type: 'blocks',
        classname: customclass,
        desktop_text_horizontal_position: section.settings.desktop_text_horizontal_position,
        desktop_text_vertical_position: section.settings.desktop_text_vertical_position,
        mobile_text_horizontal_position: section.settings.mobile_text_horizontal_position,
        mobile_text_vertical_position: section.settings.mobile_text_vertical_position,
        desktop_image: section.settings.desktop_image,
        mobile_image: section.settings.mobile_image,
        placeholder: 'detailed-apparel-1',
        blocks: section.blocks
      %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image-with-text.name",
  "tag": "section",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "header",
      "content": "Section 1 — Image first, then text"
    },
    {
      "type": "text",
      "id": "content_subheading",
      "label": "Welcome line (gold)",
      "default": "Welcome",
      "info": "Optional; appears above the title in gold."
    },
    {
      "type": "text",
      "id": "content_heading",
      "label": "Title",
      "default": "About Us"
    },
    {
      "type": "richtext",
      "id": "content_description",
      "label": "Description",
      "default": "<p>Founded with a passion for confidence and self-care, our clinic is dedicated to delivering advanced aesthetic, skin, and laser treatments using modern technology and proven techniques. Our experienced team focuses on providing safe, personalised solutions that help clients look and feel their best.</p><p>We take pride in offering high-quality cosmetic and skincare services tailored to individual needs, combining professional expertise with premium products for long-lasting, natural-looking results.</p><p>With a growing presence and a strong commitment to excellence, our goal is simple — to provide trusted care, outstanding service, and results that truly make a difference.</p>"
    },
    {
      "type": "header",
      "content": "Section 2 — Text first, then image"
    },
    {
      "type": "paragraph",
      "content": "Different content and image for the second row (text on left, image on right)."
    },
    {
      "type": "text",
      "id": "content_subheading_2",
      "label": "Welcome line (gold)"
    },
    {
      "type": "text",
      "id": "content_heading_2",
      "label": "Title",
      "default": "Our Approach"
    },
    {
      "type": "richtext",
      "id": "content_description_2",
      "label": "Description",
      "default": "<p>We combine cutting-edge technology with a personalised touch. Every treatment is tailored to your unique needs and goals, ensuring you receive the best possible care and results.</p>"
    },
    {
      "type": "image_picker",
      "id": "desktop_image_2",
      "label": "Image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_2",
      "label": "Image (mobile)"
    },
    {
      "type": "header",
      "content": "t:sections.global.general"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "image_first",
          "label": "t:sections.image-with-text.settings.layout.options__1.label"
        },
        {
          "value": "text_first",
          "label": "t:sections.image-with-text.settings.layout.options__2.label"
        }
      ],
      "default": "image_first",
      "label": "t:sections.image-with-text.settings.layout.label",
      "info": "t:sections.image-with-text.settings.layout.info"
    },
    {
      "type": "range",
      "id": "desktop-percentage-image-width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50,
      "label": "t:sections.image-with-text.settings.desktop-percentage-image-width.label"
    },
    {
      "type": "checkbox",
      "id": "full-width-enabled",
      "label": "t:sections.settings.settings.section-full-width.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.global.section-height"
    },
    {
      "type": "radio",
      "id": "slide_height",
      "label": "t:sections.slideshow.settings.slide.slide_height.default.label",
      "options": [
        {
          "value": "adapt_to_first_image",
          "label": "t:sections.slideshow.settings.slide.slide_height.adapt_to_first_image.label"
        },
        {
          "value": "fixed_height",
          "label": "t:sections.slideshow.settings.slide.slide_height.fixed_height.label"
        }
      ],
      "default": "fixed_height"
    },
    {
      "type": "range",
      "id": "desktop_fixed_height",
      "min": 200,
      "max": 1000,
      "unit": "px",
      "step": 20,
      "default": 320,
      "label": "t:sections.slideshow.settings.slide.desktop_fixed_height.label",
      "info": "t:sections.background-video.settings.original_ratio.option__1.info"
    },
    {
      "type": "range",
      "id": "mobile_fixed_height",
      "min": 200,
      "max": 1000,
      "unit": "px",
      "step": 20,
      "default": 460,
      "label": "t:sections.slideshow.settings.slide.mobile_fixed_height.label",
      "info": "t:sections.background-video.settings.original_ratio.option__1.info"
    },
    {
      "type": "header",
      "content": "t:sections.global.colors",
      "info": "t:sections.global.colors-info"
    },
    {
      "type": "color",
      "id": "section-color-body-text",
      "default": "transparent",
      "label": "t:sections.global.heading-color"
    },
    {
      "type": "color",
      "id": "section-color-overlay",
      "default": "transparent",
      "label": "t:sections.global.section-background-color"
    },
    {
      "type": "range",
      "id": "section-color-overlay-opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "label": "t:sections.settings.settings.background-opacity.label"
    },
    {
      "type": "color",
      "id": "color-body-text",
      "default": "transparent",
      "label": "t:sections.settings.settings.text-color.label"
    },
    {
      "type": "color",
      "id": "color-overlay",
