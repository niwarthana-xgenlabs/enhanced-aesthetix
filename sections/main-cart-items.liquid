<style>
  [data-section-id="{{ section.id }}"]
    {
        {% if section.settings.margin-top %}
            --section-gap-top: {{ section.settings.margin-top }}px;
        {% endif %}

        {% if section.settings.margin-bottom %}
            --section-gap-bottom: {{ section.settings.margin-bottom }}px;
        {% endif %}

        /* Override button colors */
        --color-button-primary-background: #B4975A;
        --color-button-primary-border: #B4975A;
        --color-button-primary-background-hover: #a0854e;
        --color-button-secondary-background: #B4975A;
        --color-button-secondary-border: #B4975A;
        --color-button-secondary-background-hover: #a0854e;

    }

  /* Hide booking app buttons in cart */
  [data-section-id="{{ section.id }}"] .wt-cart__item .tpb-book-on-grid-button,
  [data-section-id="{{ section.id }}"] .cart-item .tpb-book-on-grid-button,
  [data-section-id="{{ section.id }}"] .wt-cart__item__amount .tpb-book-on-grid-button,
  [data-section-id="{{ section.id }}"] .button.tpb-book-on-grid-button,
  [data-section-id="{{ section.id }}"] .wt-cart__item a[href*="book"],
  [data-section-id="{{ section.id }}"] .wt-cart__item button[class*="book"],
  [data-section-id="{{ section.id }}"] .cart-item a[href*="book"],
  [data-section-id="{{ section.id }}"] .cart-item button[class*="book"],
  [data-section-id="{{ section.id }}"] a[class*="book-"],
  [data-section-id="{{ section.id }}"] button[class*="book-"] {
    display: none !important;
  }

  /* Additional button styling for cart */
  [data-section-id="{{ section.id }}"] .button,
  [data-section-id="{{ section.id }}"] button[type="submit"],
  [data-section-id="{{ section.id }}"] .wt-cart__cta,
  [data-section-id="{{ section.id }}"] .cart__cta {
    background-color: #B4975A !important;
    border-color: #B4975A !important;
  }

  [data-section-id="{{ section.id }}"] .button:hover,
  [data-section-id="{{ section.id }}"] button[type="submit"]:hover,
  [data-section-id="{{ section.id }}"] .wt-cart__cta:hover,
  [data-section-id="{{ section.id }}"] .cart__cta:hover {
    background-color: #a0854e !important;
    border-color: #a0854e !important;
  }

  /* Move section down */
  #shopify-section-{{ section.id }},
  section[data-section-id="{{ section.id }}"],
  [data-section-id="{{ section.id }}"] {
    padding-top: 100px !important;
  }
</style>
<div data-section-id="{{ section.id }}">
  <cart-items class="cart-page">
    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart-form">
      <div class="wt-cart__wrapper cart-page" id="main-cart-items" data-id="{{ section.id }}">
        <div class="wt-cart js-contents">
          <header class="wt-cart__header {% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %}">
            {%- if cart != empty -%}
              <div class="wt-cart__header__action">
                <h2 class="wt-cart__title">
                  {{ 'sections.cart.title' | t }}
                  {% if cart.item_count > 0 %}
                    ({{ cart.item_count }})
                  {% endif %}
                </h2>
              </div>

              {% if settings.enable_free_shipping_bar %}
                {% render 'cart-free-shipping-bar' %}
              {% endif %}

            {%- else -%}
              {% render 'cart-empty' %}
            {%- endif -%}
          </header>

          {%- if cart != empty -%}
            <div class="wt-cart__body {% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %}">
              <ul class="wt-cart__list">
                {%- for item in cart.items -%}
                  {% render 'cart-item', item: item, cart_page: true, show_vendor: section.settings.show_vendor %}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      </div>
      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p
        class="visually-hidden"
        id="shopping-cart-line-item-status"
        aria-live="polite"
        aria-hidden="true"
        role="status"
      >
        {{ 'accessibility.loading' | t }}
      </p>
    </form>
  </cart-items>
</div>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.main-cart-items.settings.show_vendor.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.section_spacing"
    },
    {
      "type": "range",
      "id": "margin-top",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 40,
      "label": "t:sections.settings.settings.distance-top.label"
    },
    {
      "type": "range",
      "id": "margin-bottom",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 0,
      "label": "t:sections.settings.settings.distance-bottom.label",
      "info": "t:sections.settings.settings.distance-bottom.info"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
